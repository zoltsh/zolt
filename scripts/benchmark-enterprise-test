#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

WORK_DIR="target/benchmark-enterprise-test"

fail() {
  printf 'error: %s\n' "$1" >&2
  exit 1
}

rm -rf "$WORK_DIR"
mkdir -p "$WORK_DIR"

for topology in chain wide layered; do
  output="$WORK_DIR/$topology"
  python3 scripts/benchmark-enterprise-fixture \
    --workload benchmarks/workloads/smoke-v1.json \
    --topology "$topology" \
    --output-dir "$output" \
    >/dev/null

  jq -e '
    .schemaVersion == 1
    and .workload.modules == 8
    and .workload.platformModules == 1
    and .workload.apps == 2
    and .workload.testsPerModule == 1
    and .workload.resources == true
    and .workload.annotationProcessors == true
    and .workload.springBootApp == true
    and .correctness.expectedMainSourceFiles == 20
    and .correctness.expectedTestSourceFiles == 22
    and .correctness.expectedResourceFiles == 11
    and .sourceDigest == .toolSourceDigests.zolt
    and .sourceDigest == .toolSourceDigests.maven
    and .sourceDigest == .toolSourceDigests.gradle
  ' "$output/fixture-metadata.json" >/dev/null \
    || fail "$topology fixture metadata is incomplete"

  for competitor in maven gradle; do
    diff -qr "$output/fixtures/zolt/modules/platform/src" "$output/fixtures/$competitor/modules/platform/src" >/dev/null \
      || fail "$topology platform sources differ for $competitor"
    diff -qr "$output/fixtures/zolt/apps/app002/src" "$output/fixtures/$competitor/apps/app002/src" >/dev/null \
      || fail "$topology Spring application sources differ for $competitor"
  done

  grep -F '[dependencies.processor]' "$output/fixtures/zolt/modules/platform/zolt.toml" >/dev/null \
    || fail "$topology Zolt fixture is missing annotation processor coverage"
  grep -F '[toolchain.java.test]' "$output/fixtures/zolt/zolt.toml" >/dev/null \
    || fail "$topology Zolt fixture is missing test runtime toolchain coverage"
  grep -F '<annotationProcessorPaths>' "$output/fixtures/maven/modules/platform/pom.xml" >/dev/null \
    || fail "$topology Maven fixture is missing annotation processor coverage"
  grep -F "annotationProcessor 'org.projectlombok:lombok:" "$output/fixtures/gradle/build.gradle" >/dev/null \
    || fail "$topology Gradle fixture is missing annotation processor coverage"
  grep -F 'spring-boot-starter' "$output/fixtures/zolt/apps/app002/zolt.toml" >/dev/null \
    || fail "$topology Zolt fixture is missing the Spring Boot application"
  grep -F '@Tag("benchmark")' \
    "$output/fixtures/zolt/apps/app001/src/test/java/bench/enterprise/app001/App001Benchmark001Test.java" >/dev/null \
    || fail "$topology fixture is missing generated benchmark tests"
  grep -F "includeTags 'benchmark'" "$output/fixtures/gradle/build.gradle" >/dev/null \
    || fail "$topology Gradle fixture does not select the same tagged benchmark tests"
done

if grep -F 'lib001' "$WORK_DIR/wide/fixtures/zolt/modules/lib008/zolt.toml" >/dev/null; then
  fail "wide topology unexpectedly linked library modules"
fi
layered_edges="$(grep -c -E '^"bench\.enterprise:lib[0-9]+" = \{ workspace = true \}$' \
  "$WORK_DIR/layered/fixtures/zolt/modules/lib008/zolt.toml")"
[[ "$layered_edges" == "2" ]] \
  || fail "layered dependency fanout expected 2 graph edges, found $layered_edges"
grep -F '"bench.enterprise:lib007" = { workspace = true }' \
  "$WORK_DIR/chain/fixtures/zolt/modules/lib008/zolt.toml" >/dev/null \
  || fail "chain topology did not include its immediate predecessor"

python3 scripts/benchmark-enterprise \
  --workload benchmarks/workloads/smoke-v1.json \
  --topology layered \
  --work-dir "$WORK_DIR/runner-generate-only" \
  --generate-only \
  >/dev/null
[[ -f "$WORK_DIR/runner-generate-only/fixture-metadata.json" ]] \
  || fail "enterprise runner did not generate fixture metadata"

python3 - "$WORK_DIR/tuned-plan" <<'PY'
import argparse
import contextlib
import io
import json
import pathlib
import runpy
import sys

root = pathlib.Path.cwd()
work_dir = pathlib.Path(sys.argv[1])
sys.path.insert(0, str(root / "scripts"))
module = runpy.run_path(str(root / "scripts/benchmark-enterprise"))
args = argparse.Namespace(
    zolt="/usr/bin/true",
    maven="/usr/bin/true",
    gradle="/usr/bin/true",
    include_gradle_daemon=True,
    include_tuned_modes=True,
)
tools = module["build_tools"](args, work_dir)
by_id = {tool.identifier: tool for tool in tools}
expected = {
    "zolt",
    "maven",
    "maven-parallel",
    "gradle-no-daemon",
    "gradle-daemon",
    "gradle-parallel-configuration-cache",
}
if set(by_id) != expected:
    raise SystemExit(f"unexpected enterprise tool plan: {sorted(by_id)}")
if "-T" not in by_id["maven-parallel"].build or "1C" not in by_id["maven-parallel"].build:
    raise SystemExit("Maven tuned mode is missing -T 1C")
gradle_tuned = by_id["gradle-parallel-configuration-cache"].build
if "--parallel" not in gradle_tuned or "--configuration-cache" not in gradle_tuned:
    raise SystemExit("Gradle tuned mode is missing parallel/configuration-cache")
if by_id["maven"].root == by_id["maven-parallel"].root:
    raise SystemExit("Maven default and tuned modes share project output")
if by_id["gradle-daemon"].root == by_id["gradle-parallel-configuration-cache"].root:
    raise SystemExit("Gradle default and tuned modes share project output")
if "--compile-only" not in by_id["zolt"].test_compile:
    raise SystemExit("Zolt test compile workflow does not use --compile-only")
for command_name, command in (
    ("test compile", by_id["zolt"].test_compile),
    ("test run", by_id["zolt"].test_run),
):
    if "--timings" not in command or command[-2:] != ["--timings-format", "json"]:
        raise SystemExit(f"Zolt {command_name} workflow does not capture JSON timings")
for identifier in ("maven", "maven-parallel"):
    if by_id[identifier].test_compile[-1] != "test-compile":
        raise SystemExit(f"{identifier} test compile workflow does not use test-compile")
if by_id["gradle-no-daemon"].test_compile[-1] != "testClasses":
    raise SystemExit("Gradle test compile workflow does not use testClasses")

progress_root = (work_dir / "progress").resolve()
progress_root.mkdir(parents=True, exist_ok=True)
progress_tool = module["Tool"](
    "probe",
    progress_root,
    ["/usr/bin/true"],
    ["/usr/bin/true"],
    ["/usr/bin/true"],
    ["/usr/bin/true"],
    ["/usr/bin/true"],
    ["/usr/bin/true"],
)
progress_runner = module["Runner"](
    progress_root,
    {},
    [progress_tool],
    30,
    1,
    1,
)
progress_runner.command_total = 1

captured = io.StringIO()
with contextlib.redirect_stdout(captured):
    progress_runner.run(
        "no-op-build",
        progress_tool,
        1,
        ["/usr/bin/true"],
    )
progress = captured.getvalue()
if "benchmark command 1/1 started: no-op-build / probe / sample 1" not in progress:
    raise SystemExit("enterprise runner does not report command start progress")
if "benchmark command 1/1 finished: no-op-build / probe / sample 1" not in progress:
    raise SystemExit("enterprise runner does not report command completion progress")

timing_log = progress_root / "toolchain-timings.log"
timing_log.write_text(
    "\n".join(
        [
            "ordinary command output",
            json.dumps(
                {
                    "phase": "compile workspace test members",
                    "attributes": {
                        "workspaceToolchainLockfileParses": "1",
                        "workspaceToolchainIdentityCalculations": "1",
                        "workspaceToolchainIdentityCacheHits": "21",
                        "workspaceTestRuntimeToolchainIdentityCalculations": "0",
                        "workspaceTestRuntimeToolchainIdentityCacheHits": "0",
                    },
                }
            ),
        ]
    )
    + "\n",
    encoding="utf-8",
)
metrics = module["workspace_toolchain_metrics"](timing_log)
if metrics != {
    "workspaceToolchainLockfileParses": 1,
    "workspaceToolchainIdentityCalculations": 1,
    "workspaceToolchainIdentityCacheHits": 21,
    "workspaceTestRuntimeToolchainIdentityCalculations": 0,
    "workspaceTestRuntimeToolchainIdentityCacheHits": 0,
}:
    raise SystemExit(f"enterprise runner did not extract toolchain timings: {metrics}")

progress_runner.samples = [
    {
        "tool": "zolt",
        "workflow": "test-compile-build",
        "sample": 1,
        "workspaceToolchainMetrics": metrics,
    },
    {
        "tool": "zolt",
        "workflow": "test-run",
        "sample": 1,
        "workspaceToolchainMetrics": {
            **metrics,
            "workspaceTestRuntimeToolchainIdentityCalculations": 1,
            "workspaceTestRuntimeToolchainIdentityCacheHits": 10,
        },
    },
]
progress_runner.verify_workspace_toolchain_metrics("test-compile-build")
progress_runner.verify_workspace_toolchain_metrics("test-run")
if not all(check["passed"] for check in progress_runner.correctness["checks"]):
    raise SystemExit("enterprise runner rejected valid workspace toolchain metrics")

progress_runner.correctness["checks"] = [
    {"name": "probe-correctness", "passed": False},
]
failed_checks = progress_runner.finalize_correctness()
if failed_checks != ["probe-correctness"]:
    raise SystemExit(f"enterprise runner lost failed correctness checks: {failed_checks}")
correctness = json.loads(progress_runner.correctness_path.read_text(encoding="utf-8"))
if correctness.get("status") != "failed":
    raise SystemExit("enterprise runner did not persist failed correctness evidence")
PY

python3 scripts/benchmark-enterprise-fixture \
  --workload benchmarks/workloads/enterprise-v1.json \
  --topology layered \
  --output-dir "$WORK_DIR/enterprise-volume" \
  >/dev/null
jq -e '
  .workload.modules == 200
  and .workload.apps == 2
  and .workload.sourceFiles >= 1000
  and .workload.sourceLines >= 20000
  and .correctness.expectedFanoutModules == 200
' "$WORK_DIR/enterprise-volume/fixture-metadata.json" >/dev/null \
  || fail "publishable workload does not meet the documented volume floor"

enterprise_module="$WORK_DIR/enterprise-volume/fixtures/maven/modules/lib200/src/main/java/bench/enterprise/lib200/Lib200.java"
grep -F 'private static final String VALUE =' "$enterprise_module" >/dev/null \
  || fail "publishable fixture does not memoize generated dependency values"
grep -F 'Integer.toHexString(java.util.Objects.hash(' "$enterprise_module" >/dev/null \
  || fail "publishable fixture does not bound generated dependency value size"
if grep -F 'return String.join' "$enterprise_module" >/dev/null; then
  fail "publishable fixture recursively expands dependency values"
fi

python3 - "$WORK_DIR/enterprise-summary.json" <<'PY'
import json
import pathlib
import sys

output = pathlib.Path(sys.argv[1])
workflow_ids = [
    "dependency-setup",
    "first-clean-build",
    "clean-build",
    "no-op-build",
    "leaf-change-build",
    "shared-api-change-build",
    "resource-change-build",
    "test-compile-build",
    "test-run",
    "package",
]
tools = [
    "zolt",
    "maven",
    "maven-parallel",
    "gradle-no-daemon",
    "gradle-daemon",
    "gradle-parallel-configuration-cache",
]
workflows = []
for workflow_index, workflow in enumerate(workflow_ids):
    samples = 1 if workflow in {"dependency-setup", "first-clean-build"} else 5
    metrics = {}
    for tool_index, tool in enumerate(tools):
        median = 100 + workflow_index * 10 + tool_index * 100
        metrics[tool] = {
            "samples": samples,
            "medianMillis": median,
            "meanMillis": median,
            "standardDeviationMillis": 1,
            "coefficientOfVariation": 0.01,
            "median95ConfidenceIntervalMillis": [median - 1, median + 1] if samples > 1 else None,
            "p95Millis": median + 1,
            "minMillis": median - 1,
            "maxMillis": median + 1,
        }
    workflows.append({
        "workflow": workflow,
        "label": workflow,
        "kind": "setup" if workflow == "dependency-setup" else "cold" if workflow == "first-clean-build" else "repeated",
        "winner": None if workflow == "dependency-setup" else "zolt",
        "fastestMedianTool": "zolt",
        "zoltOutcome": "inconclusive" if samples == 1 else "faster",
        "zoltReferenceTool": "maven",
        "comparisonsVsZolt": {},
        "tools": metrics,
    })
summary = {
    "schemaVersion": 3,
    "outcomeRule": {
        "id": "paired-bootstrap-median-ratio-v1",
        "minimumSamples": 5,
        "minimumEffectRatio": 1.05,
        "confidenceLevel": 0.95,
    },
    "environment": {
        "classification": "enterprise-generated",
        "moduleCount": 200,
        "platformModules": 1,
        "appModules": 2,
        "repeatCount": 7,
        "cleanRepeatCount": 5,
        "topology": "layered",
        "layerWidth": 12,
        "dependencyFanout": 3,
        "classesPerModule": 8,
        "methodsPerClass": 4,
        "testsPerModule": 2,
        "sourceFiles": 2010,
        "sourceLines": 45000,
        "resourceFiles": 203,
        "zoltSource": "build",
        "releaseVersion": None,
        "tools": {
            tool: {"exitCode": 0, "stdout": [f"{tool} 1.0"], "stderr": []}
            for tool in tools
        },
    },
    "correctness": {
        "schemaVersion": 1,
        "status": "passed",
        "checks": [{"name": "fixture", "passed": True, "evidence": {}}],
    },
    "workflows": workflows,
}
output.write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
PY

scripts/benchmark-suite \
  --enterprise-workload benchmarks/workloads/enterprise-v1.json \
  --generated-summary "$WORK_DIR/enterprise-summary.json" \
  --topology layered \
  --skip-generated=false \
  --work-dir "$WORK_DIR/suite" \
  >/dev/null 2>&1 \
  && fail "suite unexpectedly accepted an invalid boolean option"

scripts/benchmark-suite \
  --enterprise-workload benchmarks/workloads/enterprise-v1.json \
  --generated-summary "$WORK_DIR/enterprise-summary.json" \
  --topology layered \
  --work-dir "$WORK_DIR/suite" \
  >/dev/null

jq -e '
  .run.classification == "Publication-scale enterprise validation"
  and .run.laneCount == 1
  and .lanes[0].id == "enterprise-generated-layered"
  and .lanes[0].kind == "enterprise-generated"
  and .lanes[0].summary.repeatedWorkflowCount == 8
  and .lanes[0].outcomeRule.id == "paired-bootstrap-median-ratio-v1"
  and .lanes[0].correctness.status == "passed"
  and .lanes[0].workload.cleanRepeatCount == 5
  and .lanes[0].workload.appModules == 2
' "$WORK_DIR/suite/suite-summary.json" >/dev/null \
  || fail "suite did not keep a branch-built enterprise run below publishable status"

jq '.environment.zoltSource = "release"' \
  "$WORK_DIR/enterprise-summary.json" \
  >"$WORK_DIR/unresolved-release-enterprise-summary.json"

scripts/benchmark-suite \
  --enterprise-workload benchmarks/workloads/enterprise-v1.json \
  --generated-summary "$WORK_DIR/unresolved-release-enterprise-summary.json" \
  --topology layered \
  --work-dir "$WORK_DIR/unresolved-release-suite" \
  >/dev/null

jq -e '
  .run.classification == "Publication-scale enterprise validation"
  and .lanes[0].environment.zoltSource == "release"
  and .lanes[0].environment.releaseVersion == null
' "$WORK_DIR/unresolved-release-suite/suite-summary.json" >/dev/null \
  || fail "suite treated an unresolved release as publishable evidence"

jq '.environment.zoltSource = "release" | .environment.releaseVersion = "0.1.0-zap.test"' \
  "$WORK_DIR/enterprise-summary.json" \
  >"$WORK_DIR/release-enterprise-summary.json"

scripts/benchmark-suite \
  --enterprise-workload benchmarks/workloads/enterprise-v1.json \
  --generated-summary "$WORK_DIR/release-enterprise-summary.json" \
  --topology layered \
  --work-dir "$WORK_DIR/release-suite" \
  >/dev/null

jq -e '
  .run.classification == "Publishable enterprise generated evidence"
  and .lanes[0].environment.zoltSource == "release"
  and .lanes[0].correctness.status == "passed"
' "$WORK_DIR/release-suite/suite-summary.json" >/dev/null \
  || fail "suite did not require a released Zolt for publishable evidence"

printf 'benchmark enterprise script test passed\n'
