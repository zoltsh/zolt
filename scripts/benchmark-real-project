#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

PROJECT_MANIFEST="docs/benchmarks/projects.json"
PROJECT_ID=""
WORK_DIR="target/benchmarks/competitors/real-projects"
CACHE_DIR=""
REPEAT_COUNT=3
CLEAN_REPEAT_COUNT=3
ZOLT_BIN="${ZOLT_BENCH_ZOLT:-}"
MAVEN_BIN="${ZOLT_BENCH_MAVEN:-}"
GRADLE_BIN="${ZOLT_BENCH_GRADLE:-}"
SAMPLE_TIMEOUT_SECONDS=1800
DRY_RUN=false
INCLUDE_TUNED_MODES=false

usage() {
  cat <<'USAGE'
Usage: scripts/benchmark-real-project [options]

Runs a pinned same-source Zolt, Maven, and Gradle comparison.

Options:
  --project ID             Project id from docs/benchmarks/projects.json.
  --project-manifest FILE  Project manifest. Default: docs/benchmarks/projects.json.
  --work-dir DIR           Output directory. Default: target/benchmarks/competitors/real-projects.
  --cache-dir DIR          Shared dependency cache directory. Default: WORK_DIR/caches.
  --repeat COUNT           Timed samples for repeated workflows. Default: 3.
  --clean-repeat COUNT     Timed repeated clean-build samples. Default: 3.
  --zolt PATH              Zolt executable. Default: ZOLT_BENCH_ZOLT or zolt on PATH.
  --maven PATH             Maven executable. Default: mvn on PATH.
  --gradle PATH            Gradle executable. Default: gradle on PATH.
  --sample-timeout SECONDS Per-command timeout. Default: 1800.
  --include-tuned-modes     Include Maven parallel and Gradle parallel/configuration-cache.
  --dry-run                Validate the lane and write planned outputs without cloning or timing.
  -h, --help               Show this help.

Each checked-in adapter copies one explicit upstream source set into isolated
Zolt, default Maven, and default Gradle overlays. Tuned Maven parallel and
Gradle parallel/configuration-cache overlays are optional and explicitly
labeled. Dependency caches are warmed before timing. The measured workflows are
first and repeated clean builds, a warm no-op, an implementation change, and a
public-API change. Semantic-change samples must produce distinct bytecode.
Adapter omissions remain part of every result artifact.
USAGE
}

fail() {
  printf 'error: %s\n' "$1" >&2
  exit 1
}

positive_int() {
  [[ "$1" =~ ^[1-9][0-9]*$ ]]
}

abs_path() {
  case "$1" in
    "") printf '\n' ;;
    /*) printf '%s\n' "$1" ;;
    *) printf '%s\n' "$ROOT/$1" ;;
  esac
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --project)
      [[ "$#" -ge 2 ]] || fail "--project requires a value"
      PROJECT_ID="$2"
      shift 2
      ;;
    --project-manifest)
      [[ "$#" -ge 2 ]] || fail "--project-manifest requires a value"
      PROJECT_MANIFEST="$2"
      shift 2
      ;;
    --work-dir)
      [[ "$#" -ge 2 ]] || fail "--work-dir requires a value"
      WORK_DIR="$2"
      shift 2
      ;;
    --cache-dir)
      [[ "$#" -ge 2 ]] || fail "--cache-dir requires a value"
      CACHE_DIR="$2"
      shift 2
      ;;
    --repeat)
      [[ "$#" -ge 2 ]] || fail "--repeat requires a value"
      positive_int "$2" || fail "--repeat requires a positive integer"
      REPEAT_COUNT="$2"
      shift 2
      ;;
    --clean-repeat)
      [[ "$#" -ge 2 ]] || fail "--clean-repeat requires a value"
      positive_int "$2" || fail "--clean-repeat requires a positive integer"
      CLEAN_REPEAT_COUNT="$2"
      shift 2
      ;;
    --zolt)
      [[ "$#" -ge 2 ]] || fail "--zolt requires a value"
      ZOLT_BIN="$2"
      shift 2
      ;;
    --maven)
      [[ "$#" -ge 2 ]] || fail "--maven requires a value"
      MAVEN_BIN="$2"
      shift 2
      ;;
    --gradle)
      [[ "$#" -ge 2 ]] || fail "--gradle requires a value"
      GRADLE_BIN="$2"
      shift 2
      ;;
    --sample-timeout)
      [[ "$#" -ge 2 ]] || fail "--sample-timeout requires a value"
      positive_int "$2" || fail "--sample-timeout requires a positive integer"
      SAMPLE_TIMEOUT_SECONDS="$2"
      shift 2
      ;;
    --include-tuned-modes)
      INCLUDE_TUNED_MODES=true
      shift
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      fail "unknown option '$1'"
      ;;
  esac
done

[[ -n "$PROJECT_ID" ]] || fail "--project is required"
case "$WORK_DIR" in
  "" | "." | "/" | "$ROOT") fail "refusing unsafe benchmark work directory: $WORK_DIR" ;;
esac

PROJECT_MANIFEST="$(abs_path "$PROJECT_MANIFEST")"
WORK_DIR="$(abs_path "$WORK_DIR")"
if [[ -z "$CACHE_DIR" ]]; then
  CACHE_DIR="$WORK_DIR/caches"
else
  CACHE_DIR="$(abs_path "$CACHE_DIR")"
fi
mkdir -p "$WORK_DIR"

python3 - "$ROOT" "$PROJECT_MANIFEST" "$PROJECT_ID" "$WORK_DIR" "$CACHE_DIR" "$REPEAT_COUNT" "$CLEAN_REPEAT_COUNT" "$ZOLT_BIN" "$MAVEN_BIN" "$GRADLE_BIN" "$SAMPLE_TIMEOUT_SECONDS" "$DRY_RUN" "$INCLUDE_TUNED_MODES" <<'PY'
import html
import hashlib
import json
import math
import os
import pathlib
import platform
import re
import shutil
import statistics
import subprocess
import sys
import time
import random
from datetime import datetime, timezone

repo_root = pathlib.Path(sys.argv[1])
manifest_path = pathlib.Path(sys.argv[2])
project_id = sys.argv[3]
work_dir = pathlib.Path(sys.argv[4])
cache_dir = pathlib.Path(sys.argv[5])
repeat_count = int(sys.argv[6])
clean_repeat_count = int(sys.argv[7])
explicit_zolt = sys.argv[8] or None
explicit_maven = sys.argv[9] or None
explicit_gradle = sys.argv[10] or None
sample_timeout_seconds = int(sys.argv[11])
dry_run = sys.argv[12] == "true"
include_tuned_modes = sys.argv[13] == "true"

sys.path.insert(0, str(repo_root / "scripts"))
from benchmark_statistics import OUTCOME_RULE, classify_workflow

if not manifest_path.is_file():
    raise SystemExit(f"project manifest not found: {manifest_path}")

manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
project = next((item for item in manifest.get("projects", []) if item.get("id") == project_id), None)
if not project:
    raise SystemExit(f"project not found in manifest: {project_id}")
if project.get("status") != "comparison-ready":
    raise SystemExit(f"project {project_id} is not comparison-ready")

pin = project.get("pin") or {}
pin_value = pin.get("value")
if not pin_value:
    raise SystemExit(f"project {project_id} does not have an immutable pin")

native_tool = project.get("nativeTool")
if native_tool not in {"maven", "gradle"}:
    raise SystemExit(f"unsupported upstream tool for {project_id}: {native_tool}")

adapter_path = pathlib.Path(project.get("adapterPath") or "")
if not adapter_path.is_absolute():
    adapter_path = repo_root / adapter_path
if not adapter_path.is_file():
    raise SystemExit(f"adapter coverage file not found: {adapter_path}")
coverage = json.loads(adapter_path.read_text(encoding="utf-8"))
if coverage.get("projectId") != project_id or coverage.get("status") != "comparison-ready":
    raise SystemExit(f"adapter coverage is not comparison-ready for {project_id}")
if ((coverage.get("upstream") or {}).get("commit")) != pin_value:
    raise SystemExit(f"adapter pin does not match manifest pin for {project_id}")
adapter = coverage.get("adapter") or {}
if adapter.get("type") != "generated-same-source-overlay":
    raise SystemExit(f"unsupported adapter type for {project_id}: {adapter.get('type')}")

source_roots = adapter.get("sourceRoots") or []
if not source_roots:
    raise SystemExit(f"adapter {project_id} has no source roots")
mutation_anchor = adapter.get("sourceChangeTarget")
if not mutation_anchor:
    raise SystemExit(f"adapter {project_id} has no mutation anchor")
native_build = adapter.get("nativeBuild") or None
if native_build and native_build.get("tool") != native_tool:
    raise SystemExit(
        f"adapter native build tool does not match manifest for {project_id}"
    )

work_dir.mkdir(parents=True, exist_ok=True)
checkout_dir = work_dir / "checkout"
logs_dir = work_dir / "logs"
projects_dir = work_dir / "projects"
zolt_project = projects_dir / "zolt"
maven_project = projects_dir / "maven"
maven_parallel_project = projects_dir / "maven-parallel"
gradle_no_daemon_project = projects_dir / "gradle-no-daemon"
gradle_daemon_project = projects_dir / "gradle-daemon"
gradle_tuned_project = projects_dir / "gradle-parallel-configuration-cache"
overlay_tool_ids = ["zolt", "maven"]
if include_tuned_modes:
    overlay_tool_ids.append("maven-parallel")
overlay_tool_ids.extend(["gradle-no-daemon", "gradle-daemon"])
if include_tuned_modes:
    overlay_tool_ids.append("gradle-parallel-configuration-cache")
native_tool_id = f"upstream-{native_tool}" if native_build else None
tool_ids = tuple(
    overlay_tool_ids + ([native_tool_id] if native_tool_id else [])
)
logs_dir.mkdir(parents=True, exist_ok=True)
samples_path = work_dir / "samples.jsonl"
summary_path = work_dir / "summary.json"
suite_path = work_dir / "suite-summary.json"
report_path = work_dir / "report.md"
correctness_path = work_dir / "correctness.json"


def now_iso():
    return datetime.now(timezone.utc).isoformat()


def resolve_tool(explicit, fallback):
    if explicit:
        if "/" in explicit:
            return str(pathlib.Path(explicit).resolve())
        return explicit
    return shutil.which(fallback) or fallback


tool_paths = {
    "zolt": resolve_tool(explicit_zolt, "zolt"),
    "maven": resolve_tool(explicit_maven, "mvn"),
    "gradle": resolve_tool(explicit_gradle, "gradle"),
}


def rel(path):
    try:
        return str(path.resolve().relative_to(repo_root))
    except ValueError:
        return str(path.resolve())


def run_process(command, cwd, log_name, timeout_seconds=None):
    log_path = logs_dir / log_name
    log_path.parent.mkdir(parents=True, exist_ok=True)
    started_at = now_iso()
    start = time.perf_counter_ns()
    timed_out = False
    with log_path.open("w", encoding="utf-8") as log:
        log.write("$ " + " ".join(command) + "\n\n")
        try:
            process = subprocess.run(
                command,
                cwd=str(cwd),
                stdout=log,
                stderr=subprocess.STDOUT,
                text=True,
                check=False,
                timeout=timeout_seconds,
            )
            exit_code = process.returncode
        except subprocess.TimeoutExpired:
            timed_out = True
            exit_code = 124
            log.write(f"\nCommand timed out after {timeout_seconds} seconds.\n")
        except FileNotFoundError as exc:
            exit_code = 127
            log.write(f"\n{exc}\n")
    return {
        "command": command,
        "exitCode": exit_code,
        "durationMillis": round((time.perf_counter_ns() - start) / 1_000_000),
        "timedOut": timed_out,
        "startedAt": started_at,
        "finishedAt": now_iso(),
        "log": rel(log_path),
    }


def checked(command, cwd, log_name):
    result = run_process(command, cwd, log_name, sample_timeout_seconds)
    if result["exitCode"] != 0:
        raise RuntimeError(f"command failed ({result['exitCode']}): {' '.join(command)}; log: {result['log']}")
    return result


def capture_tool(command):
    try:
        process = subprocess.run(
            command,
            cwd=str(work_dir),
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            check=False,
            timeout=30,
        )
        return {"command": command, "exitCode": process.returncode, "stdout": process.stdout.splitlines()[:20]}
    except (FileNotFoundError, subprocess.TimeoutExpired) as exc:
        return {"command": command, "exitCode": None, "error": str(exc), "stdout": []}


def prepare_checkout():
    if checkout_dir.exists() and not (checkout_dir / ".git").is_dir():
        raise RuntimeError(f"checkout path exists but is not a git repository: {checkout_dir}")
    if not checkout_dir.exists():
        checkout_dir.mkdir(parents=True)
        checked(["git", "init"], checkout_dir, "checkout/001-git-init.log")
        checked(["git", "remote", "add", "origin", project["upstreamUrl"]], checkout_dir, "checkout/002-git-remote-add.log")
    else:
        checked(["git", "remote", "set-url", "origin", project["upstreamUrl"]], checkout_dir, "checkout/002-git-remote-set-url.log")
    checked(["git", "fetch", "--depth", "1", "origin", pin_value], checkout_dir, "checkout/003-git-fetch.log")
    checked(["git", "checkout", "--detach", "FETCH_HEAD"], checkout_dir, "checkout/004-git-checkout.log")
    checked(["git", "reset", "--hard", pin_value], checkout_dir, "checkout/005-git-reset.log")
    checked(["git", "clean", "-ffdx"], checkout_dir, "checkout/006-git-clean.log")


def copy_root(row, destination):
    source = checkout_dir / row["from"]
    if not source.exists():
        if row.get("optional"):
            return
        raise RuntimeError(f"adapter source root does not exist: {row['from']}")
    target = destination / row["to"]
    if source.is_dir():
        shutil.copytree(source, target, dirs_exist_ok=True)
    else:
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, target)


def prepare_overlays():
    if projects_dir.exists():
        shutil.rmtree(projects_dir)
    destinations = [
        zolt_project,
        maven_project,
        gradle_no_daemon_project,
        gradle_daemon_project,
    ]
    if include_tuned_modes:
        destinations.extend([maven_parallel_project, gradle_tuned_project])
    for destination in destinations:
        destination.mkdir(parents=True)
        for row in source_roots:
            copy_root(row, destination)
        for row in adapter.get("resourceRoots") or []:
            copy_root(row, destination)
        for excluded in adapter.get("excludes") or []:
            target = destination / excluded
            if target.is_dir():
                shutil.rmtree(target)
            elif target.exists():
                target.unlink()
        changed = destination / mutation_anchor
        if not changed.is_file():
            raise RuntimeError(
                f"mutation anchor is missing from overlay: {mutation_anchor}"
            )
    source_count = len(list(zolt_project.glob("**/*.java")))
    if source_count == 0:
        raise RuntimeError(f"adapter {project_id} copied no Java sources")
    write_zolt_config()
    write_maven_config(maven_project)
    write_gradle_config(gradle_no_daemon_project)
    write_gradle_config(gradle_daemon_project)
    if include_tuned_modes:
        write_maven_config(maven_parallel_project)
        write_gradle_config(gradle_tuned_project)
    return source_count, sum(
        len(path.read_text(encoding="utf-8", errors="replace").splitlines())
        for path in zolt_project.glob("**/*.java")
    )


def toml_string(value):
    return json.dumps(str(value))


def write_zolt_config():
    lines = [
        "[project]",
        f"name = {toml_string(adapter['name'])}",
        f"version = {toml_string(adapter['version'])}",
        f"group = {toml_string(adapter['group'])}",
        f"java = {toml_string(adapter.get('java') or '21')}",
        "",
        "[repositories]",
        'central = "https://repo.maven.apache.org/maven2"',
    ]
    platforms = adapter.get("platforms") or {}
    if platforms:
        lines.extend(["", "[platforms]"])
        lines.extend(f"{toml_string(key)} = {toml_string(value)}" for key, value in sorted(platforms.items()))
    lines.extend(["", "[dependencies]"])
    for key, value in sorted((adapter.get("dependencies") or {}).items()):
        rendered = "{}" if value is None else toml_string(value)
        lines.append(f"{toml_string(key)} = {rendered}")
    provided = adapter.get("providedDependencies") or {}
    if provided:
        lines.extend(["", "[provided.dependencies]"])
        lines.extend(f"{toml_string(key)} = {toml_string(value)}" for key, value in sorted(provided.items()))
    lines.extend([
        "",
        "[build]",
        'source = "src/main/java"',
        'test = "src/test/java"',
        'output = "target/classes"',
        'testOutput = "target/test-classes"',
        "",
        "[compiler]",
        f"release = {toml_string(adapter['compilerRelease'])}",
        'encoding = "UTF-8"',
    ])
    resource_paths = sorted({row["to"] for row in adapter.get("resourceRoots") or [] if (zolt_project / row["to"]).exists()})
    if resource_paths:
        lines.extend(["", "[resources]", "main = [" + ", ".join(toml_string(path) for path in resource_paths) + "]"])
    (zolt_project / "src/test/java").mkdir(parents=True, exist_ok=True)
    (zolt_project / "zolt.toml").write_text("\n".join(lines) + "\n", encoding="utf-8")


def maven_dependency(coordinate, version, scope=None):
    group, artifact = coordinate.split(":", 1)
    values = [
        "    <dependency>",
        f"      <groupId>{html.escape(group)}</groupId>",
        f"      <artifactId>{html.escape(artifact)}</artifactId>",
    ]
    if version is not None:
        values.append(f"      <version>{html.escape(str(version))}</version>")
    if scope:
        values.append(f"      <scope>{scope}</scope>")
    values.append("    </dependency>")
    return values


def write_maven_config(destination):
    lines = [
        '<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"',
        '         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">',
        "  <modelVersion>4.0.0</modelVersion>",
        f"  <groupId>{html.escape(adapter['group'])}</groupId>",
        f"  <artifactId>{html.escape(adapter['name'])}</artifactId>",
        f"  <version>{html.escape(adapter['version'])}</version>",
        "  <properties>",
        f"    <maven.compiler.release>{int(adapter['compilerRelease'])}</maven.compiler.release>",
        "    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>",
        "  </properties>",
    ]
    platforms = adapter.get("platforms") or {}
    if platforms:
        lines.extend(["  <dependencyManagement>", "  <dependencies>"])
        for coordinate, version in sorted(platforms.items()):
            group, artifact = coordinate.split(":", 1)
            lines.extend([
                "    <dependency>",
                f"      <groupId>{html.escape(group)}</groupId>",
                f"      <artifactId>{html.escape(artifact)}</artifactId>",
                f"      <version>{html.escape(str(version))}</version>",
                "      <type>pom</type>",
                "      <scope>import</scope>",
                "    </dependency>",
            ])
        lines.extend(["  </dependencies>", "  </dependencyManagement>"])
    lines.append("  <dependencies>")
    for coordinate, version in sorted((adapter.get("dependencies") or {}).items()):
        lines.extend(maven_dependency(coordinate, version))
    for coordinate, version in sorted((adapter.get("providedDependencies") or {}).items()):
        lines.extend(maven_dependency(coordinate, version, "provided"))
    lines.extend([
        "  </dependencies>",
        "  <build>",
        "    <plugins>",
        "      <plugin>",
        "        <groupId>org.apache.maven.plugins</groupId>",
        "        <artifactId>maven-compiler-plugin</artifactId>",
        "        <version>3.14.1</version>",
        "      </plugin>",
        "    </plugins>",
        "  </build>",
        "</project>",
    ])
    (destination / "pom.xml").write_text("\n".join(lines) + "\n", encoding="utf-8")


def gradle_quote(value):
    return str(value).replace("\\", "\\\\").replace("'", "\\'")


def write_gradle_config(destination):
    modular_source = (destination / "src/main/java/module-info.java").is_file()
    lines = [
        "plugins { id 'java-library' }",
        f"group = '{gradle_quote(adapter['group'])}'",
        f"version = '{gradle_quote(adapter['version'])}'",
        "repositories { mavenCentral() }",
        f"java {{ modularity.inferModulePath = {'false' if modular_source else 'true'} }}",
        "dependencies {",
    ]
    for coordinate, version in sorted((adapter.get("platforms") or {}).items()):
        lines.append(f"    implementation platform('{gradle_quote(coordinate)}:{gradle_quote(version)}')")
    for coordinate, version in sorted((adapter.get("dependencies") or {}).items()):
        notation = coordinate if version is None else f"{coordinate}:{version}"
        lines.append(f"    implementation '{gradle_quote(notation)}'")
    for coordinate, version in sorted((adapter.get("providedDependencies") or {}).items()):
        lines.append(f"    compileOnly '{gradle_quote(coordinate)}:{gradle_quote(version)}'")
    lines.append("}")
    if modular_source:
        lines.append("def emptyCompileClasspath = files()")
    lines.extend([
        "tasks.withType(JavaCompile).configureEach {",
        f"    options.release = {int(adapter['compilerRelease'])}",
        "    options.encoding = 'UTF-8'",
    ])
    if modular_source:
        lines.extend([
            "    // Keep automatic modules without manifest names visible to module-info.java.",
            "    doFirst {",
            "        options.compilerArgs += ['--module-path', classpath.asPath]",
            "        classpath = emptyCompileClasspath",
            "    }",
        ])
    lines.append("}")
    (destination / "build.gradle").write_text("\n".join(lines) + "\n", encoding="utf-8")
    (destination / "settings.gradle").write_text(
        f"rootProject.name = '{gradle_quote(adapter['name'])}'\n", encoding="utf-8"
    )


zolt_cache = cache_dir / "zolt"
maven_cache = cache_dir / "maven"
maven_parallel_cache = cache_dir / "maven-parallel"
gradle_no_daemon_cache = cache_dir / "gradle-no-daemon"
gradle_daemon_cache = cache_dir / "gradle-daemon"
gradle_tuned_cache = cache_dir / "gradle-parallel-configuration-cache"
native_cache = cache_dir / (native_tool_id or "upstream-unused")


def tool_commands():
    zolt = tool_paths["zolt"]
    mvn = tool_paths["maven"]
    gradle = tool_paths["gradle"]
    maven_prefix = [mvn, f"-Dmaven.repo.local={maven_cache}", "-q"]
    gradle_no_daemon_prefix = [
        gradle,
        "--gradle-user-home",
        str(gradle_no_daemon_cache),
        "--no-daemon",
        "--console=plain",
        "--quiet",
    ]
    gradle_daemon_prefix = [
        gradle,
        "--gradle-user-home",
        str(gradle_daemon_cache),
        "--console=plain",
        "--quiet",
    ]
    maven_parallel_prefix = [
        mvn,
        f"-Dmaven.repo.local={maven_parallel_cache}",
        "-T",
        "1C",
        "-q",
    ]
    gradle_tuned_prefix = [
        gradle,
        "--gradle-user-home",
        str(gradle_tuned_cache),
        "--parallel",
        "--configuration-cache",
        "--console=plain",
        "--quiet",
    ]
    commands = {
        "zolt": {
            "cwd": zolt_project,
            "resolve": [zolt, "resolve", "--cwd", str(zolt_project), "--cache-root", str(zolt_cache)],
            "build": [
                zolt,
                "build",
                "--cwd",
                str(zolt_project),
                "--cache-root",
                str(zolt_cache),
                "--no-build-cache",
            ],
            "clean": [zolt, "clean", "--cwd", str(zolt_project)],
        },
        "maven": {
            "cwd": maven_project,
            "resolve": [*maven_prefix, "-DskipTests", "compile"],
            "build": [*maven_prefix, "-DskipTests", "compile"],
            "clean": [*maven_prefix, "clean"],
        },
        "gradle-no-daemon": {
            "cwd": gradle_no_daemon_project,
            "resolve": [*gradle_no_daemon_prefix, "dependencies", "--configuration", "compileClasspath"],
            "build": [*gradle_no_daemon_prefix, "classes"],
            "clean": [*gradle_no_daemon_prefix, "clean"],
        },
        "gradle-daemon": {
            "cwd": gradle_daemon_project,
            "resolve": [*gradle_daemon_prefix, "dependencies", "--configuration", "compileClasspath"],
            "build": [*gradle_daemon_prefix, "classes"],
            "clean": [*gradle_daemon_prefix, "clean"],
        },
    }
    if include_tuned_modes:
        commands["maven-parallel"] = {
            "cwd": maven_parallel_project,
            "resolve": [*maven_parallel_prefix, "-DskipTests", "compile"],
            "build": [*maven_parallel_prefix, "-DskipTests", "compile"],
            "clean": [*maven_parallel_prefix, "clean"],
        }
        commands["gradle-parallel-configuration-cache"] = {
            "cwd": gradle_tuned_project,
            "resolve": [
                *gradle_tuned_prefix,
                "dependencies",
                "--configuration",
                "compileClasspath",
            ],
            "build": [*gradle_tuned_prefix, "classes"],
            "clean": [*gradle_tuned_prefix, "clean"],
        }
    if native_build:
        native_cwd = checkout_dir / str(native_build.get("projectDirectory") or ".")
        resolve_args = [str(value) for value in native_build.get("resolveArgs") or []]
        build_args = [str(value) for value in native_build.get("buildArgs") or []]
        clean_args = [str(value) for value in native_build.get("cleanArgs") or []]
        if not resolve_args or not build_args or not clean_args:
            raise RuntimeError(
                f"native build commands are incomplete for {project_id}"
            )
        if native_tool == "maven":
            prefix = [mvn, f"-Dmaven.repo.local={native_cache}"]
        else:
            prefix = [
                gradle,
                "--gradle-user-home",
                str(native_cache),
                "--console=plain",
            ]
        commands[native_tool_id] = {
            "cwd": native_cwd,
            "resolve": [*prefix, *resolve_args],
            "build": [*prefix, *build_args],
            "clean": [*prefix, *clean_args],
        }
    return commands


def median(values):
    return round(statistics.median(values)) if values else None


def percentile95(values):
    if not values:
        return None
    ordered = sorted(values)
    return ordered[max(0, math.ceil(0.95 * len(ordered)) - 1)]


def median_interval(values):
    if len(values) < 2:
        return None
    rng = random.Random(20260727)
    medians = sorted(
        round(statistics.median(rng.choices(values, k=len(values))))
        for _ in range(10_000)
    )
    return [
        medians[math.floor(0.025 * (len(medians) - 1))],
        medians[math.ceil(0.975 * (len(medians) - 1))],
    ]


def metric(command, rows):
    successful = [row for row in rows if row["exitCode"] == 0]
    durations = [row["durationMillis"] for row in successful]
    mean = statistics.mean(durations) if durations else None
    deviation = statistics.pstdev(durations) if durations else None
    return {
        "command": command,
        "samples": durations,
        "sampleCount": len(rows),
        "successfulSampleCount": len(successful),
        "timedOutSampleCount": sum(1 for row in rows if row.get("timedOut")),
        "medianMillis": median(durations),
        "meanMillis": round(mean, 3) if mean is not None else None,
        "standardDeviationMillis": round(deviation, 3) if deviation is not None else None,
        "coefficientOfVariation": (
            round(deviation / mean, 6)
            if mean not in (None, 0) and deviation is not None
            else None
        ),
        "median95ConfidenceIntervalMillis": median_interval(durations),
        "p95Millis": percentile95(durations),
        "minMillis": min(durations) if durations else None,
        "maxMillis": max(durations) if durations else None,
        "logs": [row["log"] for row in rows],
    }


workflow_specs = [
    ("first-clean-build", "Clean compile with warm dependency cache", 1),
    ("clean-build", "Repeated clean compile with warm dependency cache", clean_repeat_count),
    ("warm-no-op-build", "Warm no-op compile", repeat_count),
    (
        "implementation-change-build",
        "Bytecode-affecting implementation change compile",
        repeat_count,
    ),
    (
        "api-change-build",
        "Public API constant change compile",
        repeat_count,
    ),
]
commands = tool_commands()
native_workflows = set((native_build or {}).get("workflows") or [])


def workflow_tool_ids(workflow_id):
    selected = list(overlay_tool_ids)
    if native_tool_id and workflow_id in native_workflows:
        selected.append(native_tool_id)
    return selected


def mutation_source(tool, workflow_id):
    anchor = commands[tool]["cwd"] / mutation_anchor
    source = anchor.read_text(encoding="utf-8")
    match = re.search(r"^\s*package\s+([A-Za-z_][A-Za-z0-9_.]*)\s*;", source, re.MULTILINE)
    package_name = match.group(1) if match else ""
    if workflow_id == "implementation-change-build":
        class_name = "ZoltBenchmarkImplementationMutation"
    elif workflow_id == "api-change-build":
        class_name = "ZoltBenchmarkApiMutation"
    else:
        raise RuntimeError(f"unsupported mutation workflow: {workflow_id}")
    return (
        anchor.parent / f"{class_name}.java",
        pathlib.Path(*package_name.split(".")) / f"{class_name}.class"
        if package_name
        else pathlib.Path(f"{class_name}.class"),
        package_name,
        class_name,
    )


def write_mutation(tool, workflow_id, sample_index):
    source_path, class_path, package_name, class_name = mutation_source(
        tool, workflow_id
    )
    package_line = f"package {package_name};\n\n" if package_name else ""
    if workflow_id == "implementation-change-build":
        body = (
            f"{package_line}final class {class_name} {{\n"
            f"    static int value() {{ return {sample_index}; }}\n"
            "}\n"
        )
    else:
        body = (
            f"{package_line}public final class {class_name} {{\n"
            f"    public static final int VALUE = {sample_index};\n"
            f"    private {class_name}() {{}}\n"
            "}\n"
        )
    source_path.write_text(body, encoding="utf-8")
    return source_path, class_path


samples = []
workflow_records = []
status = "dry-run" if dry_run else "complete"
failure = None
correctness = {"schemaVersion": 1, "status": "not-run", "checks": []}
source_files = None
source_lines = None

environment = {
    "os": platform.platform(),
    "machine": platform.machine(),
    "processor": platform.processor(),
    "python": platform.python_version(),
    "repeatCount": repeat_count,
    "cleanRepeatCount": clean_repeat_count,
    "sampleTimeoutSeconds": sample_timeout_seconds,
    "tools": {
        "git": capture_tool(["git", "--version"]),
        "zolt": capture_tool([tool_paths["zolt"], "--version"]),
        "maven": capture_tool([tool_paths["maven"], "--version"]),
        "gradle-no-daemon": capture_tool([tool_paths["gradle"], "--version"]),
        "gradle-daemon": capture_tool([tool_paths["gradle"], "--version"]),
    },
}
if include_tuned_modes:
    environment["tools"].update({
        "maven-parallel": environment["tools"]["maven"],
        "gradle-parallel-configuration-cache": environment["tools"][
            "gradle-daemon"
        ],
    })
if native_tool_id:
    environment["tools"][native_tool_id] = environment["tools"][
        "maven" if native_tool == "maven" else "gradle-daemon"
    ]

if dry_run:
    for workflow_id, label, sample_count in workflow_specs:
        tools = {}
        selected_tools = workflow_tool_ids(workflow_id)
        for tool in selected_tools:
            tools[tool] = {
                "command": commands[tool]["build"],
                "samples": [],
                "sampleCount": sample_count,
                "successfulSampleCount": 0,
                "timedOutSampleCount": 0,
                "medianMillis": None,
                "minMillis": None,
                "maxMillis": None,
                "logs": [],
            }
        workflow_records.append({
            "id": workflow_id,
            "label": label,
            "kind": "comparison",
            "winner": None,
            "fastestMedianTool": None,
            "zoltOutcome": "inconclusive",
            "zoltReferenceTool": None,
            "comparisonsVsZolt": {},
            "tools": tools,
        })
else:
    try:
        prepare_checkout()
        source_files, source_lines = prepare_overlays()
        for tool in tool_ids:
            checked(commands[tool]["resolve"], commands[tool]["cwd"], f"setup/{tool}-resolve.log")
            checked(commands[tool]["build"], commands[tool]["cwd"], f"setup/{tool}-build.log")

        def source_digest(project_dir):
            digest = hashlib.sha256()
            paths = sorted(
                path
                for path in project_dir.glob("**/*")
                if path.is_file()
                and (
                    path.suffix == ".java"
                    or any(
                        path.is_relative_to(project_dir / row["to"])
                        for row in adapter.get("resourceRoots") or []
                    )
                )
            )
            for path in paths:
                digest.update(str(path.relative_to(project_dir)).encode("utf-8"))
                digest.update(b"\0")
                digest.update(path.read_bytes())
                digest.update(b"\0")
            return digest.hexdigest()

        output_roots = {
            "zolt": zolt_project / "target/classes",
            "maven": maven_project / "target/classes",
            "gradle-no-daemon": gradle_no_daemon_project / "build/classes/java/main",
            "gradle-daemon": gradle_daemon_project / "build/classes/java/main",
        }
        if include_tuned_modes:
            output_roots.update({
                "maven-parallel": maven_parallel_project / "target/classes",
                "gradle-parallel-configuration-cache": (
                    gradle_tuned_project / "build/classes/java/main"
                ),
            })
        if native_tool_id:
            output_roots[native_tool_id] = (
                commands[native_tool_id]["cwd"]
                / str(native_build.get("classesDirectory") or "target/classes")
            )
        source_digests = {
            tool: source_digest(commands[tool]["cwd"])
            for tool in overlay_tool_ids
        }
        def annotation_free_package_info(project_root, relative_class):
            if pathlib.Path(relative_class).name != "package-info.class":
                return False
            source = (
                project_root
                / "src/main/java"
                / pathlib.Path(relative_class).with_suffix(".java")
            )
            if not source.is_file():
                return False
            text = source.read_text(encoding="utf-8", errors="replace")
            text = re.sub(r"/\*.*?\*/", "", text, flags=re.DOTALL)
            text = re.sub(r"//[^\n]*", "", text)
            before_package = text.partition("package")[0]
            return re.search(r"(?m)^\s*@", before_package) is None

        class_inventories = {}
        for tool, output_root in output_roots.items():
            if tool not in overlay_tool_ids:
                continue
            raw = sorted(
                str(path.relative_to(output_root))
                for path in output_root.glob("**/*.class")
            )
            ignored = sorted(
                relative_class
                for relative_class in raw
                if annotation_free_package_info(
                    commands[tool]["cwd"], relative_class
                )
            )
            class_inventories[tool] = {
                "raw": raw,
                "normalized": sorted(set(raw) - set(ignored)),
                "ignoredAnnotationFreePackageInfo": ignored,
            }
        class_sets = {
            tool: inventory["normalized"]
            for tool, inventory in class_inventories.items()
        }
        baseline_classes = class_sets["zolt"]
        correctness_checks = [
            {
                "name": "same-source-overlay-digest",
                "passed": len(set(source_digests.values())) == 1,
                "evidence": {"digests": source_digests},
            }
        ]
        correctness_checks.extend(
            {
                "name": f"{tool}-compiled-class-set",
                "passed": values == baseline_classes and bool(values),
                "evidence": {
                    "classCount": len(values),
                    "rawClassCount": len(class_inventories[tool]["raw"]),
                    "baselineClassCount": len(baseline_classes),
                    "missing": sorted(set(baseline_classes) - set(values)),
                    "extra": sorted(set(values) - set(baseline_classes)),
                    "ignoredAnnotationFreePackageInfo": (
                        class_inventories[tool][
                            "ignoredAnnotationFreePackageInfo"
                        ]
                    ),
                },
            }
            for tool, values in class_sets.items()
        )
        if native_tool_id:
            native_classes = sorted(
                str(path.relative_to(output_roots[native_tool_id]))
                for path in output_roots[native_tool_id].glob("**/*.class")
            )
            correctness_checks.append({
                "name": f"{native_tool_id}-genuine-upstream-build",
                "passed": bool(native_classes),
                "evidence": {
                    "projectDirectory": str(commands[native_tool_id]["cwd"]),
                    "buildCommand": commands[native_tool_id]["build"],
                    "classCount": len(native_classes),
                    "usesPinnedUpstreamBuildFiles": True,
                },
            })
        correctness = {
            "schemaVersion": 1,
            "status": (
                "passed"
                if all(check["passed"] for check in correctness_checks)
                else "failed"
            ),
            "checks": correctness_checks,
            "completedAt": now_iso(),
        }
        if correctness["status"] != "passed":
            raise RuntimeError("real-project correctness checks failed")

        for tool in tool_ids:
            checked(commands[tool]["clean"], commands[tool]["cwd"], f"setup/{tool}-clean.log")

        with samples_path.open("w", encoding="utf-8") as sample_stream:
            for workflow_index, (workflow_id, label, sample_count) in enumerate(workflow_specs):
                selected_tools = workflow_tool_ids(workflow_id)
                rows_by_tool = {tool: [] for tool in selected_tools}
                mutation_sources = {}
                mutation_digests = {tool: [] for tool in overlay_tool_ids}
                mutation_seed_digests = {}
                if workflow_id in {
                    "implementation-change-build",
                    "api-change-build",
                }:
                    for tool in overlay_tool_ids:
                        source_path, class_relative_path = write_mutation(
                            tool, workflow_id, 0
                        )
                        mutation_sources[tool] = source_path
                        checked(
                            commands[tool]["build"],
                            commands[tool]["cwd"],
                            f"prepare/{workflow_id}-{tool}-seed-build.log",
                        )
                        seed_class = output_roots[tool] / class_relative_path
                        if not seed_class.is_file():
                            raise RuntimeError(
                                "semantic mutation seed did not produce "
                                f"{seed_class}"
                            )
                        mutation_seed_digests[tool] = hashlib.sha256(
                            seed_class.read_bytes()
                        ).hexdigest()
                for sample_index in range(1, sample_count + 1):
                    rotation = (workflow_index + sample_index - 1) % len(selected_tools)
                    tool_order = selected_tools[rotation:] + selected_tools[:rotation]
                    for tool in tool_order:
                        if workflow_id in {"first-clean-build", "clean-build"}:
                            checked(commands[tool]["clean"], commands[tool]["cwd"], f"prepare/{workflow_id}-{tool}-{sample_index:03d}-clean.log")
                        elif workflow_id in {
                            "implementation-change-build",
                            "api-change-build",
                        }:
                            source_path, class_relative_path = write_mutation(
                                tool, workflow_id, sample_index
                            )
                            mutation_sources[tool] = source_path
                        result = run_process(
                            commands[tool]["build"],
                            commands[tool]["cwd"],
                            f"samples/{workflow_id}-{tool}-{sample_index:03d}.log",
                            sample_timeout_seconds,
                        )
                        row = {
                            "project": project_id,
                            "workflow": workflow_id,
                            "workflowLabel": label,
                            "tool": tool,
                            "executionOrder": tool_order.index(tool) + 1,
                            "sample": sample_index,
                            **result,
                        }
                        samples.append(row)
                        rows_by_tool[tool].append(row)
                        sample_stream.write(json.dumps(row) + "\n")
                        sample_stream.flush()
                        if result["exitCode"] != 0:
                            failure = {
                                "workflow": workflow_id,
                                "tool": tool,
                                "sample": sample_index,
                                "exitCode": result["exitCode"],
                                "log": result["log"],
                            }
                            status = "failed"
                            break
                        if workflow_id in {
                            "implementation-change-build",
                            "api-change-build",
                        }:
                            output_class = output_roots[tool] / class_relative_path
                            if not output_class.is_file():
                                failure = {
                                    "workflow": workflow_id,
                                    "tool": tool,
                                    "sample": sample_index,
                                    "error": (
                                        "semantic mutation did not produce "
                                        f"{output_class}"
                                    ),
                                }
                                status = "failed"
                                break
                            mutation_digests[tool].append(
                                hashlib.sha256(output_class.read_bytes()).hexdigest()
                            )
                    if failure:
                        break
                if workflow_id in {
                    "implementation-change-build",
                    "api-change-build",
                }:
                    for source_path in mutation_sources.values():
                        source_path.unlink(missing_ok=True)
                    for tool in overlay_tool_ids:
                        digests = mutation_digests[tool]
                        correctness_checks.append({
                            "name": f"{tool}-{workflow_id}-bytecode-change",
                            "passed": (
                                len(digests) == sample_count
                                and len(set(digests)) == sample_count
                                and mutation_seed_digests.get(tool) not in digests
                            ),
                            "evidence": {
                                "sampleCount": sample_count,
                                "distinctClassDigests": len(set(digests)),
                                "seedDigestChanged": (
                                    mutation_seed_digests.get(tool) not in digests
                                ),
                            },
                        })
                    if not failure:
                        for tool in overlay_tool_ids:
                            checked(
                                commands[tool]["clean"],
                                commands[tool]["cwd"],
                                f"reset/{workflow_id}-{tool}-clean.log",
                            )
                            checked(
                                commands[tool]["build"],
                                commands[tool]["cwd"],
                                f"reset/{workflow_id}-{tool}-build.log",
                            )
                tools = {
                    tool: metric(commands[tool]["build"], rows_by_tool[tool])
                    for tool in selected_tools
                }
                outcomes = classify_workflow(
                    {
                        tool: [
                            row["durationMillis"]
                            for row in rows_by_tool[tool]
                            if row["exitCode"] == 0
                        ]
                        for tool in selected_tools
                    },
                    seed=f"real-project:{project_id}:{workflow_id}",
                )
                workflow_records.append({
                    "id": workflow_id,
                    "label": label,
                    "kind": "comparison",
                    "winner": outcomes["winner"],
                    "fastestMedianTool": outcomes["fastestMedianTool"],
                    "zoltOutcome": outcomes["zoltOutcome"],
                    "zoltReferenceTool": outcomes["zoltReferenceTool"],
                    "comparisonsVsZolt": outcomes["comparisonsVsZolt"],
                    "tools": tools,
                })
                if failure:
                    break
        correctness = {
            "schemaVersion": 1,
            "status": (
                "passed"
                if all(check["passed"] for check in correctness_checks)
                else "failed"
            ),
            "checks": correctness_checks,
            "completedAt": now_iso(),
        }
        if correctness["status"] != "passed":
            raise RuntimeError("real-project semantic correctness checks failed")
    except Exception as exc:
        status = "failed"
        failure = {"error": str(exc)}
    finally:
        daemon_caches = [("gradle-daemon", gradle_daemon_cache)]
        if include_tuned_modes:
            daemon_caches.append(
                ("gradle-parallel-configuration-cache", gradle_tuned_cache)
            )
        for daemon_name, daemon_cache in daemon_caches:
            run_process(
                [
                    tool_paths["gradle"],
                    "--gradle-user-home",
                    str(daemon_cache),
                    "--stop",
                ],
                work_dir,
                f"setup/{daemon_name}-stop.log",
                60,
            )

caveats = [
    "The Zolt, Maven, and Gradle overlays compile the same copied source and resource trees with the same declared release level and dependencies.",
    "Dependency caches are warmed before timed builds; dependency download speed is not measured.",
    "Generated overlay builds do not reproduce every upstream plugin or packaging behavior.",
    "Implementation and public-API mutation classes are seeded and compiled before timing; every timed edit must produce distinct bytecode that differs from the seed.",
    "Annotation-free package-info.class outputs are normalized across compilers and disclosed in correctness evidence; annotated package metadata remains correctness-gated.",
]
if include_tuned_modes:
    caveats.append(
        "Default tool modes remain visible beside Maven -T 1C and Gradle parallel/configuration-cache modes."
    )
if native_tool_id:
    caveats.append(
        f"{native_tool_id} runs the pinned checkout's original build files for the workflows declared by the adapter."
    )
caveats.extend(project.get("coverageNotes") or [])
if dry_run:
    caveats.insert(0, "Dry run only; no repository checkout or timing samples were collected.")
if failure:
    caveats.insert(0, "At least one comparison command failed; inspect the referenced log.")

completed_workflows = sum(
    1
    for row in workflow_records
    if row.get("tools")
    and all(
        (values.get("successfulSampleCount") or 0)
        == (values.get("sampleCount") or 0)
        for values in row["tools"].values()
    )
)

project_record = {
    "id": project_id,
    "name": project.get("name"),
    "upstreamUrl": project.get("upstreamUrl"),
    "nativeTool": native_tool,
    "status": project.get("status"),
    "adapterStatus": project.get("adapterStatus"),
    "adapterPath": project.get("adapterPath"),
    "pin": pin,
    "sourceBranch": project.get("sourceBranch"),
}
tool_labels = {
    "zolt": "Zolt",
    "maven": "Maven default",
    "maven-parallel": "Maven parallel (-T 1C)",
    "gradle-no-daemon": "Gradle default (no daemon)",
    "gradle-daemon": "Gradle default (daemon)",
    "gradle-parallel-configuration-cache": (
        "Gradle tuned (parallel + configuration cache)"
    ),
    "upstream-maven": "Upstream Maven build",
    "upstream-gradle": "Upstream Gradle build",
}
lane_tools = {
    tool: {
        "label": tool_labels[tool],
        "version": environment["tools"][tool],
    }
    for tool in tool_ids
}
lane = {
    "id": f"real-{project_id}-comparison",
    "name": f"{project.get('name') or project_id} same-source comparison",
    "kind": "real-project-comparison",
    "status": status,
    "workload": {
        "project": project_record,
        "adapter": {
            "type": adapter.get("type"),
            "sourceFiles": source_files,
