#!/bin/sh
set -eu

INSTALL_ROOT="${ZOLT_INSTALL_ROOT:-$HOME/.zolt}"
CHANNEL="${ZOLT_INSTALL_CHANNEL:-zap}"
CHANNEL_URL="${ZOLT_INSTALL_CHANNEL_URL:-https://dist.zolt.sh/channels/$CHANNEL.json}"
UPDATE_CHANNEL_URL="${ZOLT_INSTALL_UPDATE_CHANNEL_URL:-https://dist.zolt.sh/channels/$CHANNEL.json}"
REQUESTED_VERSION="${ZOLT_INSTALL_VERSION:-}"
REQUESTED_TARGET="${ZOLT_INSTALL_TARGET:-}"
CURL="${ZOLT_INSTALL_CURL:-curl}"

fail() {
  printf 'error: %s\n' "$1" >&2
  exit 1
}

info() {
  printf '%s\n' "$1"
}

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

detect_target() {
  if [ -n "$REQUESTED_TARGET" ]; then
    printf '%s\n' "$REQUESTED_TARGET"
    return
  fi

  os="${ZOLT_INSTALL_UNAME_S:-$(uname -s)}"
  arch="${ZOLT_INSTALL_UNAME_M:-$(uname -m)}"
  case "$(printf '%s' "$os" | tr '[:upper:]' '[:lower:]'):$arch" in
    linux:x86_64|linux:amd64)
      printf 'linux-x64\n'
      ;;
    linux:aarch64|linux:arm64)
      printf 'linux-arm64\n'
      ;;
    darwin:x86_64|darwin:amd64)
      printf 'macos-x64\n'
      ;;
    darwin:aarch64|darwin:arm64)
      printf 'macos-arm64\n'
      ;;
    *)
      fail "unsupported platform os=$os arch=$arch. Supported Unix targets: macos-arm64, macos-x64, linux-arm64, linux-x64."
      ;;
  esac
}

download() {
  url="$1"
  output="$2"
  label="$3"
  download_status=0
  case "$url" in
    file://*)
      "$CURL" -fsSL "$url" -o "$output" 2>/dev/null || download_status=$?
      ;;
    *)
      "$CURL" \
        --proto '=https' \
        --proto-redir '=https' \
        --tlsv1.2 \
        -fsSL \
        "$url" \
        -o "$output" 2>/dev/null || download_status=$?
      ;;
  esac
  if [ "$download_status" -ne 0 ]; then
    fail "could not download $label from $url (curl exit $download_status)."
  fi
}

json_string() {
  field="$1"
  sed -n 's/.*"'"$field"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1
}

json_number() {
  field="$1"
  sed -n 's/.*"'"$field"'"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n 1
}

artifact_for_target() {
  target="$1"
  awk -v target="$target" '
    {
      line = $0
      for (position = 1; position <= length(line); position++) {
        character = substr(line, position, 1)
        if (!in_string && character == "{") {
          depth++
          if (depth == 2 && !in_object) {
            record = ""
            in_object = 1
          }
        }
        if (in_object) {
          record = record character
        }
        if (in_string) {
          if (escaped) {
            escaped = 0
          } else if (character == "\\") {
            escaped = 1
          } else if (character == "\"") {
            in_string = 0
          }
        } else if (character == "\"") {
          in_string = 1
        } else if (character == "}") {
          if (in_object && depth == 2) {
            if (record ~ "\"target\"[[:space:]]*:[[:space:]]*\"" target "\"") {
              printf "%s\n", record
              exit
            }
            record = ""
            in_object = 0
          }
          depth--
        }
      }
      if (in_object) {
        record = record "\n"
      }
    }
  '
}

sha256_file() {
  path="$1"
  if command_exists sha256sum; then
    sha256sum "$path" | awk '{ print $1 }'
  elif command_exists openssl; then
    openssl dgst -sha256 "$path" | awk '{ print $NF }'
  elif command_exists shasum; then
    shasum -a 256 "$path" | awk '{ print $1 }'
  else
    fail "sha256sum, openssl, or shasum is required to verify the Zolt archive."
  fi
}

lowercase_hex() {
  printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]'
}

verify_checksum() {
  archive="$1"
  expected="$(lowercase_hex "$2")"
  actual="$(lowercase_hex "$(sha256_file "$archive")")"
  if [ "$actual" != "$expected" ]; then
    fail "checksum mismatch for native Zolt archive. Expected $expected but found $actual."
  fi
}

validate_safe_segment() {
  label="$1"
  value="$2"
  case "$value" in
    ""|*..*|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-]*)
      fail "$label must be one safe path segment."
      ;;
  esac
}

validate_channel() {
  label="$1"
  value="$2"
  case "$value" in
    stable|preview|zap)
      ;;
    *)
      fail "$label must be stable, preview, or zap."
      ;;
  esac
}

validate_version() {
  label="$1"
  value="$2"
  validate_safe_segment "$label" "$value"
  core='(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)'
  if ! printf '%s\n' "$value" | grep -Eq "^($core|$core-(alpha|beta|rc)\.(0|[1-9][0-9]*)|$core-zap\.[0-9]{8}\.[0-9a-f]{12})$"; then
    fail "$label must be a stable, preview, or zap version."
  fi
}

validate_channel_version() {
  channel="$1"
  version="$2"
  case "$channel" in
    stable)
      pattern='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'
      ;;
    preview)
      pattern='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)-(alpha|beta|rc)\.(0|[1-9][0-9]*)$'
      ;;
    zap)
      pattern='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)-zap\.[0-9]{8}\.[0-9a-f]{12}$'
      ;;
  esac
  if ! printf '%s\n' "$version" | grep -Eq "$pattern"; then
    fail "release channel manifest version $version is not valid for channel $channel."
  fi
}

validate_archive_name() {
  label="$1"
  value="$2"
  validate_safe_segment "$label" "$value"
  case "$value" in
    *.tar.gz)
      ;;
    *.jar|*jre*|*JRE*|*.zip)
      fail "refusing non-Unix-native Zolt install artifact $value."
      ;;
    *)
      fail "unsupported Zolt archive format for Unix installer: $value."
      ;;
  esac
}

validate_url() {
  label="$1"
  value="$2"
  if [ -z "$value" ]; then
    fail "$label is missing."
  fi
  case "$value" in
    file://*)
      if [ "${allow_file_urls:-false}" = "true" ]; then
        return
      fi
      fail "$label must be an HTTPS URL."
      ;;
    https://*)
      rest="${value#https://}"
      authority="${rest%%/*}"
      case "$authority" in
        "")
          fail "$label must be an HTTPS URL with a host."
          ;;
        *@*)
          fail "$label must not include URL credentials."
          ;;
      esac
      case "$value" in
        *\?*|*\#*)
          fail "$label must not include a query or fragment."
          ;;
      esac
      ;;
    *)
      fail "$label must be an HTTPS URL."
      ;;
  esac
}

release_tag_for_channel() {
  channel="$1"
  version="$2"
  case "$channel" in
    stable)
      printf 'zolt-v%s\n' "$version"
      ;;
    preview)
      printf 'zolt-preview-v%s\n' "$version"
      ;;
    zap)
      printf 'zolt-zap-%s\n' "$version"
      ;;
  esac
}

validate_release_asset_url() {
  label="$1"
  value="$2"
  channel="$3"
  version="$4"
  asset="$5"
  case "$value" in
    file://*)
      if [ "${allow_file_urls:-false}" = "true" ]; then
        return
      fi
      ;;
  esac
  release_tag="$(release_tag_for_channel "$channel" "$version")"
  expected="https://github.com/zoltsh/releases/releases/download/$release_tag/$asset"
  if [ "$value" != "$expected" ]; then
    fail "$label must be the matching immutable zoltsh/releases asset $expected."
  fi
}

validate_sha256() {
  label="$1"
  value="$2"
  if ! printf '%s\n' "$value" | grep -Eq '^[0-9A-Fa-f]{64}$'; then
    fail "$label must be exactly 64 hexadecimal characters."
  fi
}

real_dir() {
  path="$1"
  mkdir -p "$path"
  (cd "$path" && pwd -P) || fail "could not resolve directory $path."
}

require_under_root() {
  root="$1"
  path="$2"
  label="$3"
  case "$path" in
    "$root"/*)
      ;;
    *)
      fail "$label must stay under $root."
      ;;
  esac
}

validate_tar_entry_path() {
  entry="$1"
  case "$entry" in
    ""|/*|*\\*|..|../*|*/..|*/../*)
      fail "native Zolt archive contains unsafe tar entry path: $entry."
      ;;
  esac
}

validate_tar_entries() {
  archive="$1"
  entries="$work_dir/archive.entries"
  tar -tzf "$archive" >"$entries" || fail "could not inspect native Zolt archive."
  while IFS= read -r entry; do
    validate_tar_entry_path "$entry"
  done <"$entries"
  if ! tar -tvzf "$archive" | awk 'substr($1, 1, 1) != "-" && substr($1, 1, 1) != "d" { bad = 1 } END { exit bad }'; then
    fail "native Zolt archive must contain only regular files and directories."
  fi
}

selected_target="$(detect_target)"
validate_channel "release channel" "$CHANNEL"
if [ -n "$REQUESTED_VERSION" ]; then
  validate_version "requested Zolt version" "$REQUESTED_VERSION"
fi
case "$selected_target" in
  linux-x64|linux-arm64|macos-x64|macos-arm64)
    ;;
  windows-x64)
    fail "the Zolt installer supports macOS and Linux and cannot install windows-x64."
    ;;
  *)
    fail "unsupported target $selected_target. Supported Unix targets: macos-arm64, macos-x64, linux-arm64, linux-x64."
    ;;
esac

allow_file_urls=false
case "$CHANNEL_URL" in
  file://*)
    allow_file_urls=true
    ;;
esac
validate_url "release channel URL" "$CHANNEL_URL"
validate_url "native update channel URL" "$UPDATE_CHANNEL_URL"

# The native updater shares this mkdir lease and PID:token owner protocol. A crashed
# owner is never guessed dead or displaced; recovery requires explicit operator action.
install_root="$(real_dir "$INSTALL_ROOT")"
if [ -L "$install_root/versions" ] || [ -L "$install_root/bin" ]; then
  fail "native versions and bin directories must not be symbolic links."
fi
versions_dir="$(real_dir "$install_root/versions")"
require_under_root "$install_root" "$versions_dir" "native versions directory"
work_dir="$(mktemp -d "$versions_dir/.install-attempt-XXXXXX")"
lock_dir="$install_root/.install-lock"
owner_id="$$:${work_dir##*/}"
lock_owned=false
link_tmp=""
cleanup_install() {
  cleanup_status=$?
  trap - EXIT INT TERM
  if [ -n "$link_tmp" ]; then rm -f "$link_tmp"; fi
  rm -f "$install_root/.channel-$owner_id" "$install_root/.channel-url-$owner_id" \
    "$install_root/.previous-version-$owner_id"
  rm -rf "$work_dir"
  if [ "$lock_owned" = true ] && [ ! -L "$lock_dir/owner" ] \
      && [ "$(cat "$lock_dir/owner" 2>/dev/null || true)" = "$owner_id" ]; then
    rm -f "$lock_dir/owner"
    rmdir "$lock_dir" || cleanup_status=1
  fi
  exit "$cleanup_status"
}
trap cleanup_install EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
lock_wait=0
while ! mkdir "$lock_dir" 2>/dev/null; do
  if [ -L "$lock_dir" ]; then
    fail "native installation lock is not an owned directory: $lock_dir."
  fi
  if [ "$lock_wait" -ge 120 ]; then
    lock_owner=unknown
    if [ -f "$lock_dir/owner" ] && [ ! -L "$lock_dir/owner" ]; then
      lock_owner="$(dd if="$lock_dir/owner" bs=1024 count=1 2>/dev/null || printf unknown)"
    fi
    fail "timed out waiting for native installation lock $lock_dir (owner $lock_owner). Wait for the installer to finish. If its process exited, confirm no installer is running before removing only this lock directory."
  fi
  sleep 1
  lock_wait=$((lock_wait + 1))
done
(umask 077; set -C; printf '%s\n' "$owner_id" >"$lock_dir/owner")
lock_owned=true
# All shared installation state is inspected after acquiring the lease.
if [ -L "$install_root/bin" ]; then fail "native bin directory must not be a symbolic link."; fi
bin_dir="$(real_dir "$install_root/bin")"
require_under_root "$install_root" "$bin_dir" "native bin directory"
if [ -e "$bin_dir/zolt" ] && [ ! -L "$bin_dir/zolt" ]; then
  fail "refusing to replace an unmanaged launcher at $bin_dir/zolt."
fi
if [ -d "$bin_dir/zolt" ]; then
  fail "native launcher must point to an executable file, not a directory: $bin_dir/zolt."
fi

manifest="$work_dir/channel.json"
download "$CHANNEL_URL" "$manifest" "the release channel manifest"

schema_version="$(json_number schemaVersion <"$manifest" || true)"
channel="$(json_string channel <"$manifest" || true)"
version="$(json_string version <"$manifest" || true)"
if [ "$schema_version" != "1" ]; then
  fail "unsupported release channel manifest schemaVersion ${schema_version:-missing}; expected 1."
fi
validate_channel "release channel manifest channel" "$channel"
if [ "$channel" != "$CHANNEL" ]; then
  fail "release channel manifest channel $channel does not match requested channel $CHANNEL."
fi
if [ -z "$version" ]; then
  fail "release channel manifest is missing version."
fi
validate_version "release channel manifest version" "$version"
validate_channel_version "$channel" "$version"
if [ -n "$REQUESTED_VERSION" ] && [ "$REQUESTED_VERSION" != "$version" ]; then
  fail "requested Zolt version $REQUESTED_VERSION is not available on channel ${channel:-unknown}; found $version."
fi

artifact="$(artifact_for_target "$selected_target" <"$manifest")"
if [ -z "$artifact" ]; then
  fail "release channel ${channel:-unknown} does not include native archive target $selected_target."
fi

archive="$(printf '%s\n' "$artifact" | json_string archive)"
archive_url="$(printf '%s\n' "$artifact" | json_string archiveUrl)"
checksum_url="$(printf '%s\n' "$artifact" | json_string checksumUrl || true)"
expected_sha256="$(printf '%s\n' "$artifact" | json_string sha256 || true)"
format="$(printf '%s\n' "$artifact" | json_string format)"
binary_name="$(printf '%s\n' "$artifact" | json_string binaryName)"

validate_archive_name "release channel artifact $selected_target archive" "$archive"
expected_archive="zolt-$version-$selected_target.tar.gz"
if [ "$archive" != "$expected_archive" ]; then
  fail "release channel artifact $selected_target archive must be $expected_archive."
fi
if [ "$format" != "tar.gz" ]; then
  fail "release channel artifact $selected_target has format $format; expected tar.gz."
fi
validate_safe_segment "release channel artifact $selected_target binaryName" "$binary_name"
if [ "$binary_name" != "zolt" ]; then
  fail "release channel artifact $selected_target has binaryName $binary_name; expected zolt."
fi
validate_url "release channel artifact $selected_target archiveUrl" "$archive_url"
validate_release_asset_url \
  "release channel artifact $selected_target archiveUrl" \
  "$archive_url" \
  "$channel" \
  "$version" \
  "$archive"
if [ -z "$expected_sha256" ]; then
  fail "release channel artifact $selected_target is missing its sha256 pin. The release channel manifest must pin the archive sha256; the published $archive.sha256 asset alone is not accepted."
fi
validate_sha256 "release channel artifact $selected_target sha256" "$expected_sha256"
expected_sha256="$(lowercase_hex "$expected_sha256")"
if [ -n "$checksum_url" ]; then
  validate_url "release channel artifact $selected_target checksumUrl" "$checksum_url"
  validate_release_asset_url \
    "release channel artifact $selected_target checksumUrl" \
    "$checksum_url" \
    "$channel" \
    "$version" \
    "$archive.sha256"
fi
archive_path="$work_dir/$archive"
require_under_root "$work_dir" "$archive_path" "native archive download path"
download "$archive_url" "$archive_path" "the native Zolt archive"
if [ -n "$checksum_url" ]; then
  checksum_path="$work_dir/$archive.sha256"
  require_under_root "$work_dir" "$checksum_path" "native checksum download path"
  download "$checksum_url" "$checksum_path" "the native Zolt archive checksum"
  published_sha256="$(awk '{ print $1; exit }' "$checksum_path")"
  validate_sha256 "release channel artifact $selected_target published sha256" "$published_sha256"
  published_sha256="$(lowercase_hex "$published_sha256")"
  if [ "$published_sha256" != "$expected_sha256" ]; then
    fail "release channel artifact $selected_target checksum asset publishes $published_sha256 but the release channel manifest pins $expected_sha256."
  fi
fi
verify_checksum "$archive_path" "$expected_sha256"
validate_tar_entries "$archive_path"

install_dir="$versions_dir/$version"
extract_dir="$work_dir/extract"
mkdir -p "$extract_dir"
require_under_root "$work_dir" "$extract_dir" "native archive extraction directory"
tar -xzf "$archive_path" -C "$extract_dir"
top_count="$(find "$extract_dir" -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')"
top_dir="$(find "$extract_dir" -mindepth 1 -maxdepth 1 -type d | head -n 1)"
if [ -z "$top_dir" ] || [ ! -x "$top_dir/bin/zolt" ]; then
  fail "native Zolt archive did not unpack to a directory containing bin/zolt."
fi
if [ "$top_count" != "1" ]; then
  fail "native Zolt archive must unpack to exactly one top-level directory."
fi
require_under_root "$work_dir" "$top_dir" "native archive top-level directory"
require_under_root "$versions_dir" "$install_dir" "native install directory"
require_under_root "$versions_dir" "$install_dir/bin/zolt" "native installed binary path"

# Validate the complete extracted layout before replacing an existing install.
# In particular, a failed reinstall must leave the active version runnable.
installed_version="$("$top_dir/bin/zolt" --version)"
if [ "$installed_version" != "$version" ]; then
  fail "downloaded native Zolt failed version smoke. Expected $version but got $installed_version."
fi
smoke_dir="$work_dir/smoke"
"$top_dir/bin/zolt" init --cwd "$smoke_dir" smoke >/dev/null
# Completed version directories are immutable. Reuse a verified install instead of
# deleting a directory that may still be running or serving as the rollback target.
if [ -e "$install_dir" ] || [ -L "$install_dir" ]; then
  if [ -L "$install_dir" ] || [ ! -d "$install_dir" ] || [ ! -x "$install_dir/bin/zolt" ] \
      || [ -L "$install_dir/bin" ] || [ -L "$install_dir/bin/zolt" ]; then
    fail "existing native version is incomplete or unsafe at $install_dir; select a usable version before removing it."
  fi
  installed_version="$("$install_dir/bin/zolt" --version)"
  if [ "$installed_version" != "$version" ]; then
    fail "existing native version failed version smoke at $install_dir."
  fi
else
  mv "$top_dir" "$install_dir"
fi
previous_target="$(readlink "$bin_dir/zolt" 2>/dev/null || true)"
case "$previous_target" in
  ../versions/*/bin/zolt)
    previous_version="${previous_target#../versions/}"
    previous_version="${previous_version%/bin/zolt}"
    validate_version "previous installed version" "$previous_version"
    if [ "$previous_version" != "$version" ]; then
      printf '%s\n' "$previous_version" >"$install_root/.previous-version-$owner_id"
      mv -f "$install_root/.previous-version-$owner_id" "$install_root/previous-version"
    fi
    ;;
esac
printf '%s\n' "${channel:-$CHANNEL}" >"$install_root/.channel-$owner_id"
printf '%s\n' "$UPDATE_CHANNEL_URL" >"$install_root/.channel-url-$owner_id"
link_tmp="$bin_dir/.zolt-link-$owner_id"
ln -s "../versions/$version/bin/zolt" "$link_tmp"
# Rename an adjacent symlink; never unlink the active launcher before its replacement.
mv -f "$link_tmp" "$bin_dir/zolt"
link_tmp=""
mv -f "$install_root/.channel-$owner_id" "$install_root/channel"
mv -f "$install_root/.channel-url-$owner_id" "$install_root/channel-url"

info "Installed native Zolt $version for $selected_target from channel ${channel:-unknown}."
info "Add $bin_dir to PATH to run zolt."
