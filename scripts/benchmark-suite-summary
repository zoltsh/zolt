#!/usr/bin/env bash
set -euo pipefail

SUMMARY_FILE="target/benchmarks/competitors/summary.json"
OUTPUT_FILE=""
LANE_ID="generated-workspace"
LANE_NAME="Generated Java workspace"
LANE_KIND="generated"
ARTIFACT_NAME=""

usage() {
  cat <<'USAGE'
Usage: scripts/benchmark-suite-summary [options]

Creates suite-summary.json from a benchmark lane summary.

Options:
  --summary FILE       Lane summary JSON. Default: target/benchmarks/competitors/summary.json.
  --output FILE        Suite summary JSON. Default: directory containing SUMMARY_FILE/suite-summary.json.
  --lane-id ID         Lane id. Default: generated-workspace.
  --lane-name NAME     Lane display name. Default: Generated Java workspace.
  --lane-kind KIND     Lane kind. Default: generated.
  --artifact-name NAME Uploaded artifact name recorded in the suite summary.
  -h, --help           Show this help.
USAGE
}

fail() {
  printf 'error: %s\n' "$1" >&2
  exit 1
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --summary)
      [[ "$#" -ge 2 ]] || fail "--summary requires a value"
      SUMMARY_FILE="$2"
      shift 2
      ;;
    --output)
      [[ "$#" -ge 2 ]] || fail "--output requires a value"
      OUTPUT_FILE="$2"
      shift 2
      ;;
    --lane-id)
      [[ "$#" -ge 2 ]] || fail "--lane-id requires a value"
      LANE_ID="$2"
      shift 2
      ;;
    --lane-name)
      [[ "$#" -ge 2 ]] || fail "--lane-name requires a value"
      LANE_NAME="$2"
      shift 2
      ;;
    --lane-kind)
      [[ "$#" -ge 2 ]] || fail "--lane-kind requires a value"
      LANE_KIND="$2"
      shift 2
      ;;
    --artifact-name)
      [[ "$#" -ge 2 ]] || fail "--artifact-name requires a value"
      ARTIFACT_NAME="$2"
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      fail "unknown option '$1'"
      ;;
  esac
done

[[ -f "$SUMMARY_FILE" ]] || fail "summary file not found: $SUMMARY_FILE"
if [[ -z "$OUTPUT_FILE" ]]; then
  OUTPUT_FILE="$(dirname "$SUMMARY_FILE")/suite-summary.json"
fi
mkdir -p "$(dirname "$OUTPUT_FILE")"

python3 - "$SUMMARY_FILE" "$OUTPUT_FILE" "$LANE_ID" "$LANE_NAME" "$LANE_KIND" "$ARTIFACT_NAME" <<'PY'
import json
import os
import pathlib
import sys
from datetime import datetime, timezone

summary_path = pathlib.Path(sys.argv[1])
output_path = pathlib.Path(sys.argv[2])
lane_id = sys.argv[3]
lane_name = sys.argv[4]
lane_kind = sys.argv[5]
artifact_name = sys.argv[6]
summary = json.loads(summary_path.read_text(encoding="utf-8"))

workflow_labels = {
    "setup": "Zolt dependency setup",
    "dependency-setup": "Dependency setup",
    "setup-warm-build": "First clean build",
    "first-clean-build": "First clean build",
    "clean-build": "Repeated clean build",
    "no-op-build": "Warm no-op build",
    "leaf-change-build": "Leaf implementation change",
    "implementation-change-build": "Implementation change",
    "api-change-build": "Public API change",
    "root-change-build": "Root source change",
    "shared-api-change-build": "Shared API fan-out change",
    "resource-change-build": "Resource-only change",
    "test-compile-build": "Test source change build",
    "test-run": "Warm test run",
    "package": "Package",
}
workflow_order = [
    "dependency-setup",
    "first-clean-build",
    "setup-warm-build",
    "clean-build",
    "no-op-build",
    "leaf-change-build",
    "implementation-change-build",
    "api-change-build",
    "root-change-build",
    "shared-api-change-build",
    "resource-change-build",
    "test-compile-build",
    "test-run",
    "package",
    "setup",
]
repeated_workflows = {
    "clean-build",
    "no-op-build",
    "leaf-change-build",
    "implementation-change-build",
    "api-change-build",
    "root-change-build",
    "shared-api-change-build",
    "resource-change-build",
    "test-compile-build",
    "test-run",
    "package",
}
tool_labels = {
    "zolt": "Zolt",
    "maven": "Maven default",
    "maven-parallel": "Maven parallel (-T 1C)",
    "gradle-no-daemon": "Gradle (no daemon)",
    "gradle-daemon": "Gradle (daemon)",
    "gradle-parallel-configuration-cache": (
        "Gradle tuned (parallel + configuration cache)"
    ),
    "upstream-maven": "Upstream Maven build",
    "upstream-gradle": "Upstream Gradle build",
}
tool_order = [
    "zolt",
    "maven",
    "maven-parallel",
    "gradle-no-daemon",
    "gradle-daemon",
    "gradle-parallel-configuration-cache",
    "upstream-maven",
    "upstream-gradle",
]


def sort_key(row):
    workflow = row.get("workflow", "")
    if workflow in workflow_order:
        return (workflow_order.index(workflow), workflow)
    return (len(workflow_order), workflow)


def first_version_line(environment, tool):
    info = (environment.get("tools") or {}).get(tool)
    if not info:
        return "not found"
    if info.get("error"):
        return info["error"]
    if info.get("exitCode") not in (0, None):
        return f"exit {info.get('exitCode')}"
    for line in info.get("stdout", []):
        stripped = line.strip()
        if stripped and set(stripped) == {"-"}:
            continue
        if stripped:
            return stripped
    return "version output empty"


def classify(environment, workflows, correctness):
    if environment.get("classification") == "zolt-self-host":
        if summary.get("status") == "dry-run":
            return "Zolt self-host dry run"
        if correctness.get("status") == "passed":
            return "Zolt self-host validation"
        return "Failed Zolt self-host validation"
    module_count = int(environment.get("moduleCount") or 0)
    repeat_count = int(environment.get("repeatCount") or 0)
    clean_repeat_count = int(environment.get("cleanRepeatCount") or 0)
    app_count = int(environment.get("appModules") or 1)
    source_files = int(environment.get("sourceFiles") or 0)
    source_lines = int(environment.get("sourceLines") or 0)
    comparable = [
        row
        for row in workflows
        if row.get("workflow") not in {"setup", "dependency-setup"}
        and "zolt" in row.get("tools", {})
        and (
            "maven" in row.get("tools", {})
            or "gradle-no-daemon" in row.get("tools", {})
        )
    ]
    has_production_competitors = bool(comparable) and all(
        "maven" in row.get("tools", {})
        and "maven-parallel" in row.get("tools", {})
        and "gradle-no-daemon" in row.get("tools", {})
        and "gradle-daemon" in row.get("tools", {})
        and "gradle-parallel-configuration-cache" in row.get("tools", {})
        for row in comparable
    )
    enterprise = environment.get("classification") == "enterprise-generated"
    if enterprise:
        required = {
            "first-clean-build",
            "clean-build",
            "no-op-build",
            "leaf-change-build",
            "shared-api-change-build",
            "resource-change-build",
            "test-compile-build",
            "test-run",
            "package",
        }
        present = {row.get("workflow") for row in workflows}
        correctness_passed = correctness.get("status") == "passed"
        if (
            module_count >= 200
            and app_count >= 2
            and source_files >= 1_000
            and source_lines >= 20_000
            and clean_repeat_count >= 3
            and repeat_count >= 5
            and required.issubset(present)
            and has_production_competitors
            and correctness_passed
            and environment.get("zoltSource") == "release"
            and environment.get("releaseVersion")
        ):
            return "Publishable enterprise generated evidence"
        if (
            module_count >= 200
            and app_count >= 2
            and source_files >= 1_000
            and source_lines >= 20_000
            and clean_repeat_count >= 3
            and repeat_count >= 5
            and required.issubset(present)
            and has_production_competitors
            and correctness_passed
        ):
            return "Publication-scale enterprise validation"
        if module_count < 20 or repeat_count < 3:
            return "Enterprise smoke validation"
        return "Exploratory enterprise benchmark"
    if module_count < 20 or repeat_count < 3:
        return "Smoke validation"
    if module_count >= 40 and repeat_count >= 5 and has_production_competitors:
        return "Production-grade generated evidence"
    return "Exploratory benchmark"


def display_path(path):
    if not path:
        return None
    resolved = pathlib.Path(path).resolve()
    try:
        return str(resolved.relative_to(pathlib.Path.cwd()))
    except ValueError:
        return str(resolved)


environment = summary.get("environment") or {}
correctness = summary.get("correctness") or {}
source_workflows = sorted(summary.get("workflows", []), key=sort_key)
classification = classify(environment, source_workflows, correctness)
workflow_records = []
zolt_repeated_wins = 0
repeated_count = 0
comparable_count = 0

for row in source_workflows:
    workflow = row.get("workflow")
    tools = row.get("tools") or {}
    ordered_tools = {
        tool: tools[tool]
        for tool in tool_order
        if tool in tools
    }
    for tool, metrics in tools.items():
        if tool not in ordered_tools:
            ordered_tools[tool] = metrics
    medians = {
        tool: metrics.get("medianMillis")
        for tool, metrics in ordered_tools.items()
        if isinstance(metrics.get("medianMillis"), (int, float))
    }
    winner = row.get("winner")
    if "winner" not in row:
        winner = (
            min(medians, key=medians.get)
            if medians and workflow not in {"setup", "dependency-setup"}
            else None
        )
    zolt_median = medians.get("zolt")
    ratios = {}
    if zolt_median and workflow not in {"setup", "dependency-setup"}:
        for tool, median in medians.items():
            if tool != "zolt":
                ratios[tool] = median / zolt_median
    if workflow in {"setup", "dependency-setup"}:
        kind = "setup"
    elif workflow in {"setup-warm-build", "first-clean-build"}:
        kind = "cold"
    else:
        kind = "repeated"
    if workflow in repeated_workflows:
        repeated_count += 1
        if row.get("zoltOutcome") == "faster":
            zolt_repeated_wins += 1
    if workflow not in {"setup", "dependency-setup"} and "zolt" in tools and len(tools) > 1:
        comparable_count += 1
    workflow_records.append({
        "id": workflow,
        "label": workflow_labels.get(workflow, workflow),
        "kind": kind,
        "winner": winner,
        "fastestMedianTool": row.get("fastestMedianTool"),
        "zoltOutcome": row.get("zoltOutcome") or "inconclusive",
        "zoltReferenceTool": row.get("zoltReferenceTool"),
        "comparisonsVsZolt": row.get("comparisonsVsZolt") or {},
        "tools": ordered_tools,
        "ratiosVsZolt": ratios,
    })

caveats = list(summary.get("caveats") or [])
if environment.get("classification") == "enterprise-generated":
    caveats.extend([
        "Dependency setup and the first cold clean build are separated from repeated workflow claims.",
        "Repeated clean builds retain warmed dependency and tool-process caches while removing compiled outputs.",
        "Shared API fan-out, compiled class/resource parity, annotation processing, tests, and package contents are correctness-gated.",
    ])
elif environment.get("classification") != "zolt-self-host":
    caveats.append(
        "First clean build is a single setup sample; steady-state claims should use repeated workflows."
    )
topology = environment.get("topology") or ("n/a" if lane_kind == "zolt-self-host" else "chain")
topology_notes = {
    "chain": "Serial-chain topology measures critical-path and compiler-process overhead; it does not demonstrate workspace parallelism.",
    "wide": "Wide topology measures one large parallel compilation wave followed by the app.",
    "layered": "Layered topology measures repeated dependency-ordered parallel compilation waves.",
}
caveats.extend(
    []
    if lane_kind == "zolt-self-host"
    else [topology_notes.get(topology, f"Generated workspace topology: {topology}.")]
)
if classification not in {
    "Production-grade generated evidence",
    "Publishable enterprise generated evidence",
    "Zolt self-host validation",
    "Zolt self-host dry run",
}:
    article = "an" if classification[:1].lower() in {"a", "e", "i", "o", "u"} else "a"
    caveats.append(f"This is {article} {classification.lower()} run, not production-grade evidence.")
if lane_kind != "zolt-self-host":
    available_tools = {
        tool
        for row in source_workflows
        for tool in (row.get("tools") or {})
    }
    for required_tool, label in [
        ("maven", "Maven"),
        ("maven-parallel", "Maven parallel"),
        ("gradle-no-daemon", "Gradle no-daemon"),
        ("gradle-daemon", "Gradle daemon"),
        (
            "gradle-parallel-configuration-cache",
            "Gradle parallel/configuration-cache",
        ),
    ]:
        if required_tool not in available_tools:
            caveats.append(f"{label} results are missing from at least one core comparison.")

run_url = None
if os.environ.get("GITHUB_SERVER_URL") and os.environ.get("GITHUB_REPOSITORY") and os.environ.get("GITHUB_RUN_ID"):
    run_url = (
        f"{os.environ['GITHUB_SERVER_URL']}/"
        f"{os.environ['GITHUB_REPOSITORY']}/actions/runs/"
        f"{os.environ['GITHUB_RUN_ID']}"
    )

suite = {
    "schemaVersion": 1,
    "createdAt": datetime.now(timezone.utc).isoformat(),
    "suite": {
        "name": "zolt-native-benchmarks",
        "mode": (
            "enterprise-generated"
            if lane_kind == "enterprise-generated"
            else "zolt-self-host"
            if lane_kind == "zolt-self-host"
            else "generated-workspace"
        ),
    },
    "repository": {
        "name": os.environ.get("GITHUB_REPOSITORY"),
        "ref": os.environ.get("GITHUB_REF_NAME"),
        "commit": os.environ.get("GITHUB_SHA"),
        "runId": os.environ.get("GITHUB_RUN_ID"),
        "runUrl": run_url,
    },
    "run": {
        "classification": classification,
        "zoltSource": os.environ.get("BENCHMARK_ZOLT_SOURCE"),
        "releaseChannel": os.environ.get("BENCHMARK_RELEASE_CHANNEL"),
        "releaseVersion": os.environ.get("BENCHMARK_RELEASE_VERSION") or None,
        "gradleDaemonIncluded": os.environ.get("BENCHMARK_INCLUDE_GRADLE_DAEMON") == "true",
        "tunedModesIncluded": os.environ.get("BENCHMARK_INCLUDE_TUNED_MODES") == "true",
        "artifactName": artifact_name or None,
    },
    "lanes": [
        {
            "id": lane_id,
            "name": lane_name,
            "kind": lane_kind,
            "status": summary.get("status") or "complete",
            "workload": {
                "moduleCount": environment.get("moduleCount"),
                "platformModules": environment.get("platformModules"),
                "appModules": environment.get("appModules") or 1,
                "repeatCount": environment.get("repeatCount"),
                "cleanRepeatCount": environment.get("cleanRepeatCount"),
                "topology": topology,
                "layerWidth": environment.get("layerWidth"),
                "dependencyFanout": environment.get("dependencyFanout"),
                "classesPerModule": environment.get("classesPerModule"),
                "methodsPerClass": environment.get("methodsPerClass"),
                "testsPerModule": environment.get("testsPerModule"),
                "sourceFiles": environment.get("sourceFiles"),
                "sourceLines": environment.get("sourceLines"),
                "resourceFiles": environment.get("resourceFiles"),
            },
            "environment": environment,
            "tools": {
                "zolt": first_version_line(environment, "zolt"),
                "maven": first_version_line(environment, "maven"),
                "maven-parallel": first_version_line(environment, "maven-parallel"),
                "gradle": first_version_line(environment, "gradle"),
                "gradle-no-daemon": first_version_line(environment, "gradle-no-daemon"),
                "gradle-daemon": first_version_line(environment, "gradle-daemon"),
                "gradle-parallel-configuration-cache": first_version_line(
                    environment, "gradle-parallel-configuration-cache"
                ),
            },
            "outcomeRule": summary.get("outcomeRule"),
            "correctness": correctness or None,
            "summary": {
                "classification": classification,
                "zoltFastestRepeatedWorkflows": zolt_repeated_wins,
                "repeatedWorkflowCount": repeated_count,
                "comparableWorkflowCount": comparable_count,
                "firstCleanBuildSeparated": True,
            },
            "workflows": workflow_records,
            "caveats": caveats,
            "artifacts": {
                "summaryJson": display_path(summary_path),
                "samplesJsonl": display_path(summary_path.with_name("samples.jsonl")),
                "reportMarkdown": display_path(summary_path.with_name("report.md")),
                "correctnessJson": display_path(summary_path.with_name("correctness.json"))
                    if correctness else None,
                "logsDirectory": display_path(summary_path.with_name("logs")),
            },
        }
    ],
}

output_path.write_text(json.dumps(suite, indent=2) + "\n", encoding="utf-8")
PY

printf 'wrote suite summary: %s\n' "$OUTPUT_FILE"
