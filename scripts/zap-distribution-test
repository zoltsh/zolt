#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

WORK_DIR="target/zap-distribution-test"
rm -rf "$WORK_DIR"
mkdir -p "$WORK_DIR"

fail() {
  printf 'error: %s\n' "$1" >&2
  exit 1
}

if scripts/zap-distribution --publish >"$WORK_DIR/legacy-publish.log" 2>&1; then
  fail "zap candidate builder still accepts direct publication"
fi
grep -F 'unknown argument --publish' "$WORK_DIR/legacy-publish.log" >/dev/null \
  || fail "removed direct-publication flag did not fail clearly"

python3 - <<'PY'
import pathlib

ci = pathlib.Path(".github/workflows/ci.yml").read_text(encoding="utf-8")
dispatch = pathlib.Path(".github/workflows/dispatch-zap.yml").read_text(
    encoding="utf-8"
)
builder = pathlib.Path("scripts/zap-distribution").read_text(encoding="utf-8")

if "  zap-publish:\n" in ci or "scripts/zap-distribution --publish" in ci:
    raise SystemExit("error: source CI still publishes zap artifacts directly")
for forbidden in ("DO_SPACES_", "aws s3", "s3://", "publish_install_script"):
    if forbidden in builder:
        raise SystemExit(
            f"error: zap candidate builder retains legacy publication authority: {forbidden}"
        )
required_builder_contracts = (
    "https://github.com/zoltsh/releases/releases/download/${RELEASE_TAG}",
    "Build and verify one zap-channel native Zolt candidate",
)
missing_builder = [value for value in required_builder_contracts if value not in builder]
if missing_builder:
    raise SystemExit(
        "error: zap candidate builder is missing immutable release contracts: "
        + ", ".join(repr(value) for value in missing_builder)
    )

required_dispatch_contracts = (
    "  workflow_run:\n",
    "      - ci\n",
    "      - completed\n",
    "github.event.workflow_run.event == 'push'",
    "github.event.workflow_run.head_branch == 'main'",
    "github.event.workflow_run.conclusion == 'success'",
    "check_group 'test ' 5",
    "check_group 'coverage floors' 1",
    "check_group 'smoke packaged workflows ' 4",
    "check_group 'managed Java toolchain dogfood ' 2",
    "uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1",
    "owner: zoltsh",
    "repositories: releases",
    "permission-actions: write",
    "gh workflow run zap-candidate.yml",
    "--repo zoltsh/releases",
    "--ref main",
    'source_repository=${SOURCE_REPOSITORY}',
    'source_sha=${SOURCE_SHA}',
    'source_run_id=${SOURCE_RUN_ID}',
)
missing = [value for value in required_dispatch_contracts if value not in dispatch]
if missing:
    raise SystemExit(
        "error: zap dispatch handoff is missing: " + ", ".join(repr(value) for value in missing)
    )
PY

python3 - <<'PY'
import pathlib
import re

# Every zap archive ships these next to VERSION; they are assembled from the
# workspace root, so a missing or empty file here silently ships an archive
# that no longer satisfies its own license terms.
legal_documents = ("LICENSE", "NOTICE", "THIRD_PARTY_NOTICES")
for name in legal_documents:
    path = pathlib.Path(name)
    if not path.is_file():
        raise SystemExit(
            f"error: {name} is missing from the repository root; zap archives ship it at their root"
        )
    if not path.read_text(encoding="utf-8").strip():
        raise SystemExit(f"error: {name} is empty; zap archives must ship real notice text")

notices = pathlib.Path("THIRD_PARTY_NOTICES").read_text(encoding="utf-8")


def require_current_lock(lock_text):
    top_level = []
    for line in lock_text.splitlines():
        if line.lstrip().startswith("["):
            break
        match = re.fullmatch(r"version = ([0-9]+)", line)
        if match:
            top_level.append(int(match.group(1)))
    if len(top_level) != 1:
        raise ValueError("missing, malformed, or duplicate top-level version")
    if top_level[0] != 7:
        raise ValueError(f"unsupported version {top_level[0]}; current version is 7")


invalid_lock_controls = {
    "pre-v7": "version = 6\n\n[[package]]\n",
    "missing": "[[package]]\n",
    "malformed": 'version = "7"\n\n[[package]]\n',
    "nested": "[metadata]\nversion = 7\n\n[[package]]\n",
    "duplicate": "version = 7\nversion = 7\n\n[[package]]\n",
}
for label, control in invalid_lock_controls.items():
    try:
        require_current_lock(control)
    except ValueError:
        pass
    else:
        raise SystemExit(
            f"error: zolt.lock version preflight accepted its {label} negative control"
        )
require_current_lock("version = 7\n\n[[package]]\n")


def unattributed(components, notices_text):
    # Attribution only counts when one component entry names the exact Maven
    # identifier and the exact bundled version together. Searching the whole
    # file for each string independently lets `org.antlr:antlr4` ride on
    # `org.antlr:antlr4-runtime`, and lets a stale version pass because some
    # unrelated entry happens to spell it.
    attributed = {}
    for entry in re.split(r"\n[ \t]*\n", notices_text):
        identifier = re.search(r"^[ \t]*Maven coordinates:[ \t]*(\S+)[ \t]*$", entry, re.M)
        version = re.search(r"^[ \t]*Version:[ \t]*(\S+)[ \t]*$", entry, re.M)
        if identifier and version:
            attributed.setdefault(identifier.group(1), set()).add(version.group(1))
    return sorted(
        f"{identifier}:{version}"
        for identifier, version in components
        if version not in attributed.get(identifier, frozenset())
    )


control_notices = """\
ANTLR 4 Java runtime
    Maven coordinates: org.antlr:antlr4-runtime
    Version:           4.11.1
    License:           BSD-3-Clause (Appendix A)

tomlj
    Maven coordinates: org.tomlj:tomlj
    Version:           1.1.1
    License:           Apache-2.0 (see LICENSE in this distribution)

legacy helper
    Maven coordinates: com.example:legacy
    Version:           1.1.0
    License:           Apache-2.0 (see LICENSE in this distribution)
"""
controls = (
    # A prefix of a listed identifier is a different component.
    ("substring identifier", (("org.antlr:antlr4", "4.11.1"),), ["org.antlr:antlr4:4.11.1"]),
    # A version bump must bite even though another entry still spells the old one.
    ("stale version", (("org.tomlj:tomlj", "1.1.0"),), ["org.tomlj:tomlj:1.1.0"]),
    # Exactly attributed components must keep passing.
    (
        "exact attribution",
        (("org.antlr:antlr4-runtime", "4.11.1"), ("org.tomlj:tomlj", "1.1.1")),
        [],
    ),
)
for label, components, expected in controls:
    actual = unattributed(components, control_notices)
    if actual != expected:
        raise SystemExit(
            f"error: THIRD_PARTY_NOTICES attribution check failed its {label} control: "
            f"expected {expected} but reported {actual}"
        )

lock_text = pathlib.Path("zolt.lock").read_text(encoding="utf-8")
try:
    require_current_lock(lock_text)
except ValueError as error:
    raise SystemExit(f"error: zolt.lock cannot drive zap attribution: {error}") from error

bundled = []
for block in lock_text.split("[[package]]")[1:]:

    def field(key, block=block):
        match = re.search(rf'^{key} = "([^"]*)"', block, re.M)
        return match.group(1) if match else ""

    identifier = field("id")
    if field("scope") in ("compile", "runtime") and not identifier.startswith("sh.zolt:"):
        bundled.append((identifier, field("version")))

unlisted = unattributed(bundled, notices)
if unlisted:
    raise SystemExit(
        "error: THIRD_PARTY_NOTICES does not attribute bundled components: "
        + ", ".join(sorted(unlisted))
    )
if not bundled:
    raise SystemExit("error: no bundled third-party components found in zolt.lock; check the parser")
PY

printf 'zap distribution legal document contract test passed\n'
printf 'zap candidate and dispatch authority boundary test passed\n'
