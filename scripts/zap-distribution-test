#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

WORK_DIR="target/zap-distribution-test"
rm -rf "$WORK_DIR"
mkdir -p "$WORK_DIR"

fail() {
  printf 'error: %s\n' "$1" >&2
  exit 1
}

if scripts/zap-distribution --publish >"$WORK_DIR/legacy-publish.log" 2>&1; then
  fail "zap candidate builder still accepts direct publication"
fi
grep -F 'unknown argument --publish' "$WORK_DIR/legacy-publish.log" >/dev/null \
  || fail "removed direct-publication flag did not fail clearly"

if ZOLT_RELEASE_CHANNEL=preview scripts/zap-distribution \
    >"$WORK_DIR/preview-version-required.log" 2>&1; then
  fail "preview candidate builder accepted a missing release version"
fi
grep -F 'preview requires ZOLT_RELEASE_VERSION' \
    "$WORK_DIR/preview-version-required.log" >/dev/null \
  || fail "missing preview version did not fail clearly"

if ZOLT_RELEASE_CHANNEL=preview ZOLT_RELEASE_VERSION=0.2.0-alpha.1 \
    scripts/zap-distribution >"$WORK_DIR/preview-core-mismatch.log" 2>&1; then
  fail "preview candidate builder accepted a version for another core release"
fi
grep -F 'does not match workspace version' \
    "$WORK_DIR/preview-core-mismatch.log" >/dev/null \
  || fail "mismatched preview core version did not fail clearly"

for stable_version in '' 1.0.0-rc.1 01.0.0; do
  if ZOLT_RELEASE_CHANNEL=stable ZOLT_RELEASE_VERSION="$stable_version" \
      scripts/zap-distribution >"$WORK_DIR/stable-invalid-version.log" 2>&1; then
    fail "stable candidate builder accepted an invalid release version"
  fi
  grep -F 'stable requires ZOLT_RELEASE_VERSION' \
      "$WORK_DIR/stable-invalid-version.log" >/dev/null \
    || fail "invalid stable version did not fail clearly"
done

if ZOLT_RELEASE_CHANNEL=stable ZOLT_RELEASE_VERSION=99.0.0 \
    scripts/zap-distribution >"$WORK_DIR/stable-core-mismatch.log" 2>&1; then
  fail "stable candidate builder accepted a version for another core release"
fi
grep -F 'does not match workspace version' \
    "$WORK_DIR/stable-core-mismatch.log" >/dev/null \
  || fail "mismatched stable core version did not fail clearly"

python3 - <<'PY'
import pathlib

ci = pathlib.Path(".github/workflows/ci.yml").read_text(encoding="utf-8")
dispatch = pathlib.Path(".github/workflows/dispatch-zap.yml").read_text(
    encoding="utf-8"
)
preview_dispatch = pathlib.Path(".github/workflows/dispatch-preview.yml").read_text(
    encoding="utf-8"
)
builder = pathlib.Path("scripts/zap-distribution").read_text(encoding="utf-8")
stable_dispatch = pathlib.Path(".github/workflows/dispatch-stable.yml").read_text(encoding="utf-8")

if "  zap-publish:\n" in ci or "scripts/zap-distribution --publish" in ci:
    raise SystemExit("error: source CI still publishes zap artifacts directly")
for forbidden in ("DO_SPACES_", "aws s3", "s3://", "publish_install_script"):
    if forbidden in builder:
        raise SystemExit(
            f"error: zap candidate builder retains legacy publication authority: {forbidden}"
        )
required_builder_contracts = (
    "https://github.com/zoltsh/releases/releases/download/${RELEASE_TAG}",
    "Build and verify one zap, preview, or stable native Zolt candidate",
    'RELEASE_TAG="zolt-preview-v${VERSION}"',
    "preview requires ZOLT_RELEASE_VERSION",
    'RELEASE_TAG="zolt-v${VERSION}"',
    "stable requires ZOLT_RELEASE_VERSION",
)
missing_builder = [value for value in required_builder_contracts if value not in builder]
if missing_builder:
    raise SystemExit(
        "error: zap candidate builder is missing immutable release contracts: "
        + ", ".join(repr(value) for value in missing_builder)
    )

required_dispatch_contracts = (
    "  workflow_run:\n",
    "      - ci\n",
    "      - completed\n",
    "github.event.workflow_run.event == 'push'",
    "github.event.workflow_run.head_branch == 'main'",
    "github.event.workflow_run.conclusion == 'success'",
    "check_group 'test ' 5",
    "check_group 'coverage floors' 1",
    "check_group 'stable Java lifecycle' 1",
    "check_group 'smoke packaged workflows ' 4",
    "check_group 'managed Java toolchain dogfood ' 2",
    "uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1",
    "owner: zoltsh",
    "repositories: releases",
    "permission-actions: write",
    "gh workflow run zap-candidate.yml",
    "--repo zoltsh/releases",
    "--ref main",
    'source_repository=${SOURCE_REPOSITORY}',
    'source_sha=${SOURCE_SHA}',
    'source_run_id=${SOURCE_RUN_ID}',
)
missing = [value for value in required_dispatch_contracts if value not in dispatch]
if missing:
    raise SystemExit(
        "error: zap dispatch handoff is missing: " + ", ".join(repr(value) for value in missing)
    )

required_preview_dispatch_contracts = (
    "      - 'v*.*.*-*'",
    "gh workflow run preview-candidate.yml",
    "--repo zoltsh/releases",
    "--ref main",
    'source_repository=${SOURCE_REPOSITORY}',
    'source_sha=${SOURCE_SHA}',
    'source_tag=${SOURCE_TAG}',
    "permission-actions: write",
    "Verify and resolve protected source tag",
    'select(.object.type == "tag")',
    '.verification.verified == true',
    '.verification.reason == "valid"',
    'SOURCE_SHA: ${{ steps.source.outputs.source_sha }}',
)
missing_preview = [
    value for value in required_preview_dispatch_contracts if value not in preview_dispatch
]
if missing_preview:
    raise SystemExit(
        "error: preview dispatch handoff is missing: "
        + ", ".join(repr(value) for value in missing_preview)
    )

required_stable_dispatch_contracts = (
    "      - '!v*.*.*-*'",
    "gh workflow run stable.yml",
    "--repo zoltsh/releases",
    "--ref main",
    'source_repository=${SOURCE_REPOSITORY}',
    'source_sha=${SOURCE_SHA}',
    'source_tag=${SOURCE_TAG}',
    'select(.object.type == "tag")',
    '.verification.verified == true',
    '.verification.reason == "valid"',
    'SOURCE_SHA: ${{ steps.source.outputs.source_sha }}',
)
missing_stable = [value for value in required_stable_dispatch_contracts if value not in stable_dispatch]
if missing_stable:
    raise SystemExit("error: stable dispatch handoff is missing: " + ", ".join(missing_stable))
