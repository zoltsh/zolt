#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

WORK_DIR="target/benchmark-real-project-test"
UPSTREAM="$WORK_DIR/upstream"
ADAPTER="$WORK_DIR/coverage.json"
MANIFEST="$WORK_DIR/projects.json"
FAKE_ZOLT="$WORK_DIR/fake-zolt"
FAKE_MAVEN="$WORK_DIR/fake-maven"
FAKE_GRADLE="$WORK_DIR/fake-gradle"

fail() {
  printf 'error: %s\n' "$1" >&2
  exit 1
}

rm -rf "$WORK_DIR"
mkdir -p \
  "$UPSTREAM/src/main/java/example/annotated" \
  "$UPSTREAM/src/main/resources"

cat >"$UPSTREAM/pom.xml" <<'EOF'
<project>
  <modelVersion>4.0.0</modelVersion>
  <groupId>example</groupId>
  <artifactId>native-fixture</artifactId>
  <version>1.0.0</version>
</project>
EOF

cat >"$UPSTREAM/build.gradle" <<'EOF'
plugins { id 'java' }
EOF

cat >"$UPSTREAM/src/main/java/module-info.java" <<'EOF'
module example.fixture {
    exports example;
}
EOF

cat >"$UPSTREAM/src/main/java/example/Sample.java" <<'EOF'
package example;

public final class Sample {
    public String value() {
        return "sample";
    }
}
EOF
cat >"$UPSTREAM/src/main/java/example/package-info.java" <<'EOF'
/**
 * Annotation-free package documentation. Maven may emit an empty class file
 * for this source while other javac integrations omit it.
 */
package example;
EOF
cat >"$UPSTREAM/src/main/java/example/annotated/package-info.java" <<'EOF'
@Deprecated
package example.annotated;
EOF
printf 'fixture=true\n' >"$UPSTREAM/src/main/resources/application.properties"

git -C "$UPSTREAM" init -q
git -C "$UPSTREAM" config user.name "Benchmark Test"
git -C "$UPSTREAM" config user.email "benchmark@example.test"
git -C "$UPSTREAM" config commit.gpgsign false
git -C "$UPSTREAM" add .
git -C "$UPSTREAM" commit -q -m "fixture"
PIN="$(git -C "$UPSTREAM" rev-parse HEAD)"
UPSTREAM_ABS="$(cd "$UPSTREAM" && pwd)"

cat >"$ADAPTER" <<EOF
{
  "schemaVersion": 2,
  "projectId": "PROJECT_ID",
  "status": "comparison-ready",
  "upstream": { "url": "$UPSTREAM_ABS", "branch": "main", "commit": "$PIN" },
  "adapter": {
    "type": "generated-same-source-overlay",
    "group": "example",
    "name": "real-project-fixture",
    "version": "1.0.0",
    "java": "21",
    "compilerRelease": 17,
    "sourceRoots": [{ "from": "src/main/java", "to": "src/main/java" }],
    "resourceRoots": [{ "from": "src/main/resources", "to": "src/main/resources" }],
    "sourceChangeTarget": "src/main/java/example/Sample.java",
    "nativeBuild": {
      "tool": "NATIVE_TOOL",
      "projectDirectory": ".",
      "classesDirectory": "NATIVE_CLASSES",
      "workflows": ["first-clean-build", "clean-build", "warm-no-op-build"],
      "resolveArgs": ["compile"],
      "buildArgs": ["compile"],
      "cleanArgs": ["clean"]
    },
    "platforms": {},
    "dependencies": {},
    "providedDependencies": {},
    "excludes": [],
    "coveredWorkflows": ["first-clean-build", "clean-build", "warm-no-op-build", "implementation-change-build", "api-change-build"],
    "omittedBuildFeatures": ["tests"]
  }
}
EOF

cat >"$FAKE_ZOLT" <<'FAKE'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == "--version" ]]; then
  printf 'fake zolt 1.0\n'
  exit 0
fi
case "${1:-}" in
  resolve) printf 'zolt resolve ok\n' ;;
  clean)
    rm -rf target/classes
    printf 'zolt clean ok\n'
    ;;
  build)
    mkdir -p target/classes
    find src/main/java -name '*.java' -print0 | xargs -0 javac -d target/classes
    printf 'zolt build ok\n'
    ;;
  *) exit 2 ;;
esac
FAKE

cat >"$FAKE_MAVEN" <<'FAKE'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == "--version" ]]; then
  printf 'fake maven 1.0\n'
  exit 0
fi
[[ -f pom.xml ]] || exit 3
if [[ " $* " == *" clean "* ]]; then
  rm -rf target/classes
else
  mkdir -p target/classes
  find src/main/java -name '*.java' -print0 | xargs -0 javac -d target/classes
  mkdir -p target/classes/example
  : >target/classes/example/package-info.class
fi
printf 'maven ok\n'
FAKE

cat >"$FAKE_GRADLE" <<'FAKE'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == "--version" ]]; then
  printf 'fake gradle 1.0\n'
  exit 0
fi
if [[ " $* " == *" --stop "* ]]; then
  printf 'gradle stopped\n'
  exit 0
fi
[[ -f build.gradle ]] || exit 3
if [[ " $* " == *" clean "* ]]; then
  rm -rf build/classes/java/main
else
  mkdir -p build/classes/java/main
  find src/main/java -name '*.java' -print0 | xargs -0 javac -d build/classes/java/main
fi
printf 'gradle ok\n'
FAKE
chmod +x "$FAKE_ZOLT" "$FAKE_MAVEN" "$FAKE_GRADLE"

for tool in maven gradle; do
  project_id="fixture-$tool"
  if [[ "$tool" == "maven" ]]; then
    native_classes="target/classes"
  else
    native_classes="build/classes/java/main"
  fi
  sed \
    -e "s/PROJECT_ID/$project_id/g" \
    -e "s/NATIVE_TOOL/$tool/g" \
    -e "s|NATIVE_CLASSES|$native_classes|g" \
    "$ADAPTER" >"$WORK_DIR/$project_id-coverage.json"
  cat >"$MANIFEST" <<EOF
{
  "schemaVersion": 2,
  "projects": [{
    "id": "$project_id",
    "name": "Fixture $tool",
    "upstreamUrl": "$UPSTREAM_ABS",
    "sourceBranch": "main",
    "nativeTool": "$tool",
    "status": "comparison-ready",
    "adapterStatus": "main-source-ready",
    "adapterPath": "$WORK_DIR/$project_id-coverage.json",
    "pin": { "type": "commit", "value": "$PIN", "sourceBranch": "main" },
    "workflows": ["first-clean-build", "clean-build", "warm-no-op-build", "implementation-change-build", "api-change-build"],
    "coverageNotes": ["Fixture coverage note."]
  }]
}
EOF

  scripts/benchmark-real-project \
    --project "$project_id" \
    --project-manifest "$MANIFEST" \
    --work-dir "$WORK_DIR/run-$tool" \
    --repeat 2 \
    --clean-repeat 2 \
    --zolt "$FAKE_ZOLT" \
    --maven "$FAKE_MAVEN" \
    --gradle "$FAKE_GRADLE" \
    --include-tuned-modes \
    >/dev/null

  jq -e --arg tool "$tool" '
    .schemaVersion == 3
    and .status == "complete"
    and (.workflows | length) == 5
    and .correctness.status == "passed"
    and all(.workflows[];
      ((.tools | keys) - ["upstream-maven", "upstream-gradle"] | sort)
      == (["zolt", "maven", "maven-parallel", "gradle-no-daemon", "gradle-daemon", "gradle-parallel-configuration-cache"] | sort)
      and all(.tools[]; .sampleCount == .successfulSampleCount)
      and all(.tools[]; has("p95Millis") and has("standardDeviationMillis") and has("median95ConfidenceIntervalMillis"))
      and .zoltOutcome == "inconclusive"
    )
  ' "$WORK_DIR/run-$tool/summary.json" >/dev/null \
    || fail "$tool comparison summary did not record five successful workflows"

  jq -e --arg tool "$tool" '
    .lanes[0].kind == "real-project-comparison"
    and .lanes[0].status == "complete"
    and .lanes[0].summary.completedWorkflowCount == 5
    and .lanes[0].correctness.status == "passed"
    and ((.lanes[0].tools | keys) - ["upstream-maven", "upstream-gradle"] | sort)
      == (["zolt", "maven", "maven-parallel", "gradle-no-daemon", "gradle-daemon", "gradle-parallel-configuration-cache"] | sort)
    and (.lanes[0].tools | has("upstream-" + $tool))
  ' "$WORK_DIR/run-$tool/suite-summary.json" >/dev/null \
    || fail "$tool suite lane was not a completed real-project comparison"

  for competitor in maven maven-parallel gradle-no-daemon gradle-daemon gradle-parallel-configuration-cache; do
    diff -qr \
      "$WORK_DIR/run-$tool/projects/zolt/src/main" \
      "$WORK_DIR/run-$tool/projects/$competitor/src/main" \
      >/dev/null || fail "$competitor overlay did not contain the same source and resource trees"
  done

  for gradle_mode in gradle-no-daemon gradle-daemon gradle-parallel-configuration-cache; do
    generated_gradle="$WORK_DIR/run-$tool/projects/$gradle_mode/build.gradle"
    grep -F "java { modularity.inferModulePath = false }" "$generated_gradle" >/dev/null \
      || fail "$gradle_mode overlay did not disable incomplete Gradle module-path inference"
    grep -F "options.compilerArgs += ['--module-path', classpath.asPath]" "$generated_gradle" >/dev/null \
      || fail "$gradle_mode overlay did not put the full compile classpath on the module path"
    grep -F "def emptyCompileClasspath = files()" "$generated_gradle" >/dev/null \
      || fail "$gradle_mode overlay did not create a configuration-cache-safe empty classpath"
    grep -F "classpath = emptyCompileClasspath" "$generated_gradle" >/dev/null \
      || fail "$gradle_mode overlay did not clear the duplicate compile classpath"
  done

  jq -e --arg native "upstream-$tool" '
    any(.checks[];
      .name == ($native + "-genuine-upstream-build")
      and .passed
      and .evidence.usesPinnedUpstreamBuildFiles
      and (.evidence.projectDirectory | endswith("/checkout"))
    )
    and any(.checks[];
      (.name | endswith("-implementation-change-build-bytecode-change"))
      and .passed
      and .evidence.seedDigestChanged
    )
    and any(.checks[];
      (.name | endswith("-api-change-build-bytecode-change"))
      and .passed
      and .evidence.seedDigestChanged
    )
  ' "$WORK_DIR/run-$tool/correctness.json" >/dev/null \
    || fail "$tool comparison did not prove native-build and semantic-mutation correctness"

  jq -e '
    any(.checks[];
      .name == "maven-compiled-class-set"
      and .passed
      and .evidence.rawClassCount == (.evidence.classCount + 1)
      and .evidence.ignoredAnnotationFreePackageInfo == ["example/package-info.class"]
      and .evidence.baselineClassCount == 3
    )
    and any(.checks[];
      .name == "zolt-compiled-class-set"
      and .passed
      and .evidence.ignoredAnnotationFreePackageInfo == []
      and .evidence.baselineClassCount == 3
    )
  ' "$WORK_DIR/run-$tool/correctness.json" >/dev/null \
    || fail "$tool comparison did not normalize only annotation-free package metadata"
done

jq -e '
  .schemaVersion == 2
  and (.projects | length) == 5
  and all(.projects[];
    .status == "comparison-ready"
    and (.adapterStatus | endswith("ready"))
    and (.pin.value | length) == 40
    and (.adapterPath | length) > 0
  )
' docs/benchmarks/projects.json >/dev/null \
  || fail "configured real-project manifest is not fully pinned and comparison-ready"

while IFS= read -r adapter_path; do
  jq -e '
    .status == "comparison-ready"
    and .adapter.type == "generated-same-source-overlay"
    and (.adapter.sourceRoots | length) > 0
    and (.adapter.coveredWorkflows == ["first-clean-build", "clean-build", "warm-no-op-build", "implementation-change-build", "api-change-build"])
  ' "$adapter_path" >/dev/null || fail "adapter is not comparison-ready: $adapter_path"
done < <(jq -r '.projects[].adapterPath' docs/benchmarks/projects.json)

printf 'benchmark real-project comparison script test passed\n'
